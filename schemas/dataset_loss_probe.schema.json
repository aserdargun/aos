{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS synthetic real-model forward/loss preflight",
  "type": "object",
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}},
  "properties": {
    "schema_version": {"const": "1.0"}, "probe": {"const": "decider_forward_loss_v1"}, "synthetic": {"const": true},
    "training_ready": {"const": false}, "weights_loaded": {"const": true}, "gradient_run": {"const": false},
    "optimizer_run": {"const": false}, "parameters_unchanged": {"const": true},
    "checkpoint_revision": {"$ref": "#/$defs/revision"}, "code_revision": {"$ref": "#/$defs/revision"},
    "manifest_sha256": {"$ref": "#/$defs/hash"}, "weights_sha256": {"$ref": "#/$defs/hash"},
    "layouts": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "properties": {
          "layout": {"enum": ["state_first", "schema_first"]}, "decisions": {"const": 4},
          "padded_tokens": {"type": "integer", "minimum": 64, "maximum": 1536, "multipleOf": 64},
          "mean_nll": {"type": "number", "minimum": 0}, "correct_choices": {"type": "integer", "minimum": 0, "maximum": 4}
        },
        "required": ["layout", "decisions", "padded_tokens", "mean_nll", "correct_choices"], "additionalProperties": false
      }
    },
    "peak_vram_allocated_bytes": {"type": "integer", "minimum": 1},
    "peak_vram_reserved_bytes": {"type": "integer", "minimum": 1},
    "elapsed_seconds": {"type": "number", "exclusiveMinimum": 0}
  },
  "required": ["schema_version", "probe", "synthetic", "training_ready", "weights_loaded", "gradient_run", "optimizer_run", "parameters_unchanged", "checkpoint_revision", "code_revision", "manifest_sha256", "weights_sha256", "layouts", "peak_vram_allocated_bytes", "peak_vram_reserved_bytes", "elapsed_seconds"],
  "additionalProperties": false
}
