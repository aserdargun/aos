{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "const": "explicit_post_run_json_readback",
      "default": "explicit_post_run_json_readback",
      "title": "Mode",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "form_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Form Plan Sha256",
      "type": "string"
    },
    "run_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Run Ref",
      "type": "string"
    },
    "source_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Snapshot Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "response_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Response Sha256",
      "type": "string"
    },
    "response_bytes": {
      "maximum": 65536,
      "minimum": 1,
      "title": "Response Bytes",
      "type": "integer"
    },
    "observed_value_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Observed Value Sha256",
      "type": "string"
    },
    "cookie_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cookie Sha256"
    },
    "declared_value_matched": {
      "const": true,
      "default": true,
      "title": "Declared Value Matched",
      "type": "boolean"
    },
    "tls_hostname_verified": {
      "const": true,
      "default": true,
      "title": "Tls Hostname Verified",
      "type": "boolean"
    },
    "browser_connected": {
      "const": false,
      "default": false,
      "title": "Browser Connected",
      "type": "boolean"
    },
    "account_verified": {
      "const": false,
      "default": false,
      "title": "Account Verified",
      "type": "boolean"
    },
    "site_outcome_verified": {
      "const": false,
      "default": false,
      "title": "Site Outcome Verified",
      "type": "boolean"
    },
    "collection_authorized": {
      "const": false,
      "default": false,
      "title": "Collection Authorized",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "default": false,
      "title": "Training Ready",
      "type": "boolean"
    }
  },
  "required": [
    "plan_sha256",
    "profile_sha256",
    "form_plan_sha256",
    "run_ref",
    "source_snapshot_sha256",
    "request_sha256",
    "response_sha256",
    "response_bytes",
    "observed_value_sha256"
  ],
  "title": "RemoteFormJSONOracleReport",
  "type": "object"
}
