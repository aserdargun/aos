{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mode": {
      "const": "audited_remote_page_draft_seed",
      "default": "audited_remote_page_draft_seed",
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "const": "unreviewed_private_draft",
      "default": "unreviewed_private_draft",
      "title": "Status",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "before_run_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Before Run Ref",
      "type": "string"
    },
    "after_run_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "After Run Ref",
      "type": "string"
    },
    "route_index": {
      "title": "Route Index",
      "type": "integer"
    },
    "url_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Url Sha256",
      "type": "string"
    },
    "page_fingerprint_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Page Fingerprint Sha256",
      "type": "string"
    },
    "page_key": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Page Key",
      "type": "string"
    },
    "draft_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Draft Sha256",
      "type": "string"
    },
    "profile_bound": {
      "const": true,
      "default": true,
      "title": "Profile Bound",
      "type": "boolean"
    },
    "readback_verified": {
      "const": true,
      "default": true,
      "title": "Readback Verified",
      "type": "boolean"
    },
    "semantic_page_key_verified": {
      "const": false,
      "default": false,
      "title": "Semantic Page Key Verified",
      "type": "boolean"
    },
    "origin_verified": {
      "const": false,
      "default": false,
      "title": "Origin Verified",
      "type": "boolean"
    },
    "account_verified": {
      "const": false,
      "default": false,
      "title": "Account Verified",
      "type": "boolean"
    },
    "reviewed": {
      "const": false,
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "collection_authorized": {
      "const": false,
      "default": false,
      "title": "Collection Authorized",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "default": false,
      "title": "Training Ready",
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_sha256",
    "profile_sha256",
    "plan_sha256",
    "before_run_ref",
    "after_run_ref",
    "route_index",
    "url_sha256",
    "page_fingerprint_sha256",
    "page_key",
    "draft_sha256"
  ],
  "title": "RemotePageDraftSeedReport",
  "type": "object"
}
