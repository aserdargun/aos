{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "title": "Schema Version", "type": "string"},
    "synthetic": {"const": true, "title": "Synthetic", "type": "boolean"},
    "status": {"const": "structure_only", "title": "Status", "type": "string"},
    "plan_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Plan Sha256", "type": "string"},
    "skill_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Skill Sha256", "type": "string"},
    "profile_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Profile Sha256", "type": "string"},
    "page_draft_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Page Draft Sha256", "type": "string"},
    "task_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Task Key", "type": "string"},
    "model_role": {"enum": ["system1", "system2"], "title": "Model Role", "type": "string"},
    "case_count": {"maximum": 16, "minimum": 3, "title": "Case Count", "type": "integer"},
    "development_count": {"maximum": 14, "minimum": 1, "title": "Development Count", "type": "integer"},
    "held_out_count": {"maximum": 15, "minimum": 2, "title": "Held Out Count", "type": "integer"},
    "source_variant_count": {"maximum": 16, "minimum": 1, "title": "Source Variant Count", "type": "integer"},
    "execution_performed": {"const": false, "title": "Execution Performed", "type": "boolean"},
    "outcomes_verified": {"const": false, "title": "Outcomes Verified", "type": "boolean"},
    "skill_validated": {"const": false, "title": "Skill Validated", "type": "boolean"},
    "reviewed": {"const": false, "title": "Reviewed", "type": "boolean"},
    "activation_authorized": {"const": false, "title": "Activation Authorized", "type": "boolean"},
    "training_ready": {"const": false, "title": "Training Ready", "type": "boolean"}
  },
  "required": ["schema_version", "synthetic", "status", "plan_sha256", "skill_sha256", "profile_sha256", "page_draft_sha256", "task_key", "model_role", "case_count", "development_count", "held_out_count", "source_variant_count", "execution_performed", "outcomes_verified", "skill_validated", "reviewed", "activation_authorized", "training_ready"],
  "title": "SiteSkillValidationReport",
  "type": "object"
}
