{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "title": "Schema Version", "type": "string"},
    "synthetic": {"const": true, "title": "Synthetic", "type": "boolean"},
    "status": {"const": "admission_ready", "title": "Status", "type": "string"},
    "skill_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Skill Sha256", "type": "string"},
    "skill_plan_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Skill Plan Sha256", "type": "string"},
    "case_inputs_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Case Inputs Sha256", "type": "string"},
    "case_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Case Key", "type": "string"},
    "profile_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Profile Sha256", "type": "string"},
    "task_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Task Sha256", "type": "string"},
    "form_plan_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Form Plan Sha256", "type": "string"},
    "state_plan_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "State Plan Sha256", "type": "string"},
    "field_binding_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Field Binding Sha256", "type": "string"},
    "stages": {
      "items": {"enum": ["open_entry", "read_state_before", "fill_form", "submit_form", "read_receipt", "read_state_after"], "type": "string"},
      "title": "Stages",
      "type": "array"
    },
    "fresh_approval_per_stage": {"const": true, "title": "Fresh Approval Per Stage", "type": "boolean"},
    "maximum_post_count": {"const": 1, "title": "Maximum Post Count", "type": "integer"},
    "execution_authorized": {"const": false, "title": "Execution Authorized", "type": "boolean"},
    "collection_authorized": {"const": false, "title": "Collection Authorized", "type": "boolean"},
    "skill_executed": {"const": false, "title": "Skill Executed", "type": "boolean"},
    "site_outcome_verified": {"const": false, "title": "Site Outcome Verified", "type": "boolean"},
    "reviewed": {"const": false, "title": "Reviewed", "type": "boolean"},
    "activation_authorized": {"const": false, "title": "Activation Authorized", "type": "boolean"},
    "training_ready": {"const": false, "title": "Training Ready", "type": "boolean"}
  },
  "required": [
    "schema_version", "synthetic", "status", "skill_sha256", "skill_plan_sha256",
    "case_inputs_sha256", "case_key", "profile_sha256", "task_sha256",
    "form_plan_sha256", "state_plan_sha256", "field_binding_sha256", "stages",
    "fresh_approval_per_stage", "maximum_post_count", "execution_authorized",
    "collection_authorized", "skill_executed", "site_outcome_verified", "reviewed",
    "activation_authorized", "training_ready"
  ],
  "title": "SiteSkillFormInvocation",
  "type": "object"
}
