{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "suite": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Suite",
      "type": "string"
    },
    "track": {
      "enum": [
        "anomaly",
        "mode"
      ],
      "title": "Track",
      "type": "string"
    },
    "program_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Program Version",
      "type": "string"
    }
  },
  "required": [
    "suite",
    "track",
    "program_version"
  ],
  "title": "ScientistAgentPayload",
  "type": "object"
}
