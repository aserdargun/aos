{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS fresh-run JSON-bundle metadata recheck",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "review_sha256", "knowledge_sha256", "profile_sha256", "plan_sha256", "current_run_ref", "page_key", "draft_revision", "landmark_keys", "page_fingerprint_sha256", "metadata_reviewed", "current_readback_bound", "origin_verified", "account_verified", "site_outcome_verified", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "remote_json_knowledge_recheck"},
    "status": {"const": "reviewed_metadata_matched"},
    "review_sha256": {"$ref": "#/$defs/hash"},
    "knowledge_sha256": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "current_run_ref": {"$ref": "#/$defs/hash"},
    "page_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "draft_revision": {"type": "integer", "minimum": 1, "maximum": 100},
    "landmark_keys": {"type": "array", "uniqueItems": true, "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}},
    "page_fingerprint_sha256": {"$ref": "#/$defs/hash"},
    "metadata_reviewed": {"const": true},
    "current_readback_bound": {"const": true},
    "origin_verified": {"const": false},
    "account_verified": {"const": false},
    "site_outcome_verified": {"const": false},
    "task_retrieval_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
