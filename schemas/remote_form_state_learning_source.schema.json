{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS read-only HTTPS form declared-state learning source",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_remote_form_state_source"},
    "status": {"const": "unreviewed_transport_candidate"},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_ref": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_roles": {
      "type": "array", "items": {"enum": ["system1", "system2"]},
      "uniqueItems": true, "maxItems": 2
    },
    "source_event_ids_by_role": {
      "type": "object",
      "required": ["system1", "system2"],
      "additionalProperties": false,
      "properties": {
        "system1": {"type": "array", "items": {"type": "string", "pattern": "^learning-[a-f0-9]{64}$"}, "uniqueItems": true, "maxItems": 32},
        "system2": {"type": "array", "items": {"type": "string", "pattern": "^learning-[a-f0-9]{64}$"}, "uniqueItems": true, "maxItems": 32}
      }
    },
    "approved_stage_count": {"const": 6},
    "submit_count": {"const": 1},
    "transport_readback_verified": {"const": true},
    "declared_state_readback_verified": {"const": true},
    "site_outcome_verified": {"const": false},
    "account_verified": {"const": false},
    "rights_reviewed": {"const": false},
    "redaction_reviewed": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "required": [
    "schema_version", "mode", "status", "profile_sha256", "plan_sha256",
    "state_plan_sha256", "run_ref", "snapshot_sha256", "requested_roles",
    "source_event_ids_by_role", "approved_stage_count", "submit_count",
    "transport_readback_verified", "declared_state_readback_verified",
    "site_outcome_verified", "account_verified", "rights_reviewed",
    "redaction_reviewed", "collection_authorized", "training_ready"
  ]
}
