{
  "$defs": {
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "description": "Reserved wall-clock seconds, not measured or billed usage",
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_tokens": {
          "description": "Reserved model tokens, not a runtime GPU grant",
          "maximum": 10000000,
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "experiments": {
          "description": "Reserved experiment count; zero for non-experiment operations",
          "maximum": 10000,
          "minimum": 0,
          "title": "Experiments",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "model_tokens",
        "experiments"
      ],
      "title": "AgentBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Agent Id",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Version",
      "type": "string"
    },
    "adapter_kind": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Adapter Kind",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "max_active_instances": {
      "maximum": 64,
      "minimum": 1,
      "title": "Max Active Instances",
      "type": "integer"
    },
    "per_job_budget": {
      "$ref": "#/$defs/AgentBudget"
    },
    "aggregate_budget": {
      "$ref": "#/$defs/AgentBudget"
    },
    "cleanup_scope": {
      "enum": [
        "local_process",
        "scientist_gpu"
      ],
      "title": "Cleanup Scope",
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "version",
    "adapter_kind",
    "capabilities",
    "max_active_instances",
    "per_job_budget",
    "aggregate_budget",
    "cleanup_scope"
  ],
  "title": "AgentRegistration",
  "type": "object"
}
