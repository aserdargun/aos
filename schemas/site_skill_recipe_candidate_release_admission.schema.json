{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned selected recipe release admission observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "synthetic": {"const": true, "type": "boolean"},
    "candidate_execution_sha256": {"$ref": "#/$defs/checksum"},
    "candidate_sha256": {"$ref": "#/$defs/checksum"},
    "invocation_sha256": {"$ref": "#/$defs/checksum"},
    "review_sha256": {"$ref": "#/$defs/checksum"},
    "release_sha256": {"$ref": "#/$defs/checksum"},
    "selection_sha256": {"$ref": "#/$defs/checksum"},
    "family_sha256": {"$ref": "#/$defs/checksum"},
    "selection_admission_verified": {"const": true, "type": "boolean"},
    "activation_authorized": {"const": false, "type": "boolean"},
    "training_ready": {"const": false, "type": "boolean"},
    "independent_held_out": {"const": false, "type": "boolean"}
  },
  "required": ["schema_version", "synthetic", "candidate_execution_sha256",
    "candidate_sha256", "invocation_sha256", "review_sha256", "release_sha256",
    "selection_sha256", "family_sha256", "selection_admission_verified",
    "activation_authorized", "training_ready", "independent_held_out"],
  "$defs": {"checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
