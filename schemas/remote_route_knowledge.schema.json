{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS read-only remote route to manual page draft preview",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{"if": {"required": ["link_sample_sha256"]},
             "then": {"required": ["outgoing_route_indices", "outgoing_knowledge_sha256"]}},
            {"if": {"required": ["outgoing_route_indices"]},
             "then": {"required": ["link_sample_sha256", "outgoing_knowledge_sha256"]}},
            {"if": {"required": ["outgoing_knowledge_sha256"]},
             "then": {"required": ["link_sample_sha256", "outgoing_route_indices"]}}],
  "required": ["schema_version", "mode", "status", "knowledge_sha256", "draft_revision", "page_key", "route_index", "page_fingerprint_sha256", "profile_sha256", "plan_sha256", "snapshot_sha256", "before_run_ref", "after_run_ref", "profile_bound", "route_readback_bound", "origin_verified", "account_verified", "site_outcome_verified", "reviewed", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_remote_route_knowledge"},
    "status": {"const": "candidate_remote_profile_bound"},
    "knowledge_sha256": {"$ref": "#/$defs/checksum"},
    "draft_revision": {"type": "integer", "minimum": 1, "maximum": 100},
    "page_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "route_index": {"type": "integer", "minimum": 0, "maximum": 7},
    "page_fingerprint_sha256": {"$ref": "#/$defs/checksum"},
    "link_sample_sha256": {"$ref": "#/$defs/checksum"},
    "outgoing_route_indices": {"type": "array", "minItems": 1, "maxItems": 16,
                               "uniqueItems": true,
                               "items": {"type": "integer", "minimum": 0, "maximum": 7}},
    "outgoing_knowledge_sha256": {"type": "array", "minItems": 1, "maxItems": 16,
                                  "uniqueItems": true,
                                  "items": {"$ref": "#/$defs/checksum"}},
    "profile_sha256": {"$ref": "#/$defs/checksum"},
    "plan_sha256": {"$ref": "#/$defs/checksum"},
    "snapshot_sha256": {"$ref": "#/$defs/checksum"},
    "before_run_ref": {"$ref": "#/$defs/checksum"},
    "after_run_ref": {"$ref": "#/$defs/checksum"},
    "profile_bound": {"const": true},
    "route_readback_bound": {"const": true},
    "origin_verified": {"const": false},
    "account_verified": {"const": false},
    "site_outcome_verified": {"const": false},
    "reviewed": {"const": false},
    "task_retrieval_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
