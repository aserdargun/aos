{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned candidate review receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "synthetic": {"const": true, "type": "boolean"},
    "decision": {"const": "accept", "type": "string"},
    "purpose": {"const": "development_review", "type": "string"},
    "reviewer": {"const": "local_authenticated_user", "type": "string"},
    "candidate_sha256": {"$ref": "#/$defs/checksum"},
    "source_run_ref": {"$ref": "#/$defs/checksum"},
    "source_invocation_sha256": {"$ref": "#/$defs/checksum"},
    "source_group_sha256": {"$ref": "#/$defs/checksum"},
    "source_fingerprint_sha256": {"$ref": "#/$defs/checksum"},
    "candidate_execution_sha256": {"$ref": "#/$defs/checksum"},
    "execution_run_ref": {"$ref": "#/$defs/checksum"},
    "invocation_sha256": {"$ref": "#/$defs/checksum"},
    "recipe_sha256": {"$ref": "#/$defs/checksum"},
    "skill_sha256": {"$ref": "#/$defs/checksum"},
    "profile_sha256": {"$ref": "#/$defs/checksum"},
    "case_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "parameter_variant_sha256": {"$ref": "#/$defs/checksum"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "expected_outcome_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "parameter_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "form_field_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
        "steps": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "step_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "operation": {"enum": ["open_entry", "fill_form", "read_state_before", "submit_form", "read_receipt", "read_state_after"]}
            },
            "required": ["step_key", "operation"]
          }
        }
      },
      "required": ["skill_key", "expected_outcome_key", "parameter_key", "form_field_name", "steps"]
    },
    "activation_authorized": {"const": false, "type": "boolean"},
    "training_ready": {"const": false, "type": "boolean"},
    "independent_held_out": {"const": false, "type": "boolean"}
  },
  "required": ["schema_version", "synthetic", "decision", "purpose", "reviewer", "candidate_sha256", "source_run_ref", "source_invocation_sha256", "source_group_sha256", "source_fingerprint_sha256", "candidate_execution_sha256", "execution_run_ref", "invocation_sha256", "recipe_sha256", "skill_sha256", "profile_sha256", "case_key", "parameter_variant_sha256", "summary", "activation_authorized", "training_ready", "independent_held_out"],
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
