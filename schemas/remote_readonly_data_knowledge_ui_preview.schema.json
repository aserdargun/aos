{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS exact JSON-bundle metadata candidate preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "candidate_sha256", "candidate"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "remote_json_metadata_candidate_preview"},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "status", "knowledge_sha256", "draft_revision", "page_key", "page_fingerprint_sha256", "profile_sha256", "plan_sha256", "snapshot_sha256", "before_run_ref", "after_run_ref", "asset_count", "data_count", "profile_bound", "transport_readback_bound", "origin_verified", "account_verified", "site_outcome_verified", "reviewed", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "mode": {"const": "read_only_remote_json_bundle_knowledge"},
        "status": {"const": "candidate_remote_profile_bound"},
        "knowledge_sha256": {"$ref": "#/$defs/hash"},
        "draft_revision": {"type": "integer", "minimum": 1, "maximum": 100},
        "page_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "page_fingerprint_sha256": {"$ref": "#/$defs/hash"},
        "profile_sha256": {"$ref": "#/$defs/hash"},
        "plan_sha256": {"$ref": "#/$defs/hash"},
        "snapshot_sha256": {"$ref": "#/$defs/hash"},
        "before_run_ref": {"$ref": "#/$defs/hash"},
        "after_run_ref": {"$ref": "#/$defs/hash"},
        "asset_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "data_count": {"type": "integer", "minimum": 1, "maximum": 4},
        "profile_bound": {"const": true},
        "transport_readback_bound": {"const": true},
        "origin_verified": {"const": false},
        "account_verified": {"const": false},
        "site_outcome_verified": {"const": false},
        "reviewed": {"const": false},
        "task_retrieval_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "collection_authorized": {"const": false},
        "training_ready": {"const": false}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
