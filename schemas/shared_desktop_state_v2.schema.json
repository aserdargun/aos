{
  "$defs": {
    "LifecycleBirth": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "runtime_id": {
          "pattern": "^desktop-[a-f0-9]{32}$",
          "title": "Runtime Id",
          "type": "string"
        },
        "container_name": {
          "pattern": "^aos-desktop-[a-f0-9]{20}$",
          "title": "Container Name",
          "type": "string"
        },
        "image_id": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Image Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceIdentity"
        },
        "process": {
          "$ref": "#/$defs/ProcessIdentity"
        }
      },
      "required": [
        "runtime_id",
        "container_name",
        "image_id",
        "source_sha256",
        "workspace",
        "process"
      ],
      "title": "LifecycleBirth",
      "type": "object"
    },
    "ProcessIdentity": {
      "additionalProperties": false,
      "properties": {
        "boot_id": {
          "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
          "title": "Boot Id",
          "type": "string"
        },
        "pid": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Pid",
          "type": "integer"
        },
        "start_ticks": {
          "minimum": 1,
          "title": "Start Ticks",
          "type": "integer"
        },
        "pid_namespace": {
          "minimum": 1,
          "title": "Pid Namespace",
          "type": "integer"
        },
        "uid": {
          "minimum": 1,
          "title": "Uid",
          "type": "integer"
        }
      },
      "required": [
        "boot_id",
        "pid",
        "start_ticks",
        "pid_namespace",
        "uid"
      ],
      "title": "ProcessIdentity",
      "type": "object"
    },
    "SessionRuntimeBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "pattern": "^desktop-session-[a-f0-9]{32}$",
          "title": "Session Id",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "birth": {
          "$ref": "#/$defs/LifecycleBirth"
        },
        "container_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "generation",
        "birth",
        "container_id"
      ],
      "title": "SessionRuntimeBinding",
      "type": "object"
    },
    "SharedServiceBinding": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "swapp-aos-gpu-shared-desktop-default.service",
          "default": "swapp-aos-gpu-shared-desktop-default.service",
          "title": "Unit",
          "type": "string"
        },
        "invocation_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Invocation Id",
          "type": "string"
        },
        "process": {
          "$ref": "#/$defs/ProcessIdentity"
        },
        "control_group": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Control Group",
          "type": "string"
        }
      },
      "required": [
        "invocation_id",
        "process",
        "control_group"
      ],
      "title": "SharedServiceBinding",
      "type": "object"
    },
    "SharedTokenIdentity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "uid": {
          "minimum": 1,
          "title": "Uid",
          "type": "integer"
        },
        "mode": {
          "const": 384,
          "default": 384,
          "title": "Mode",
          "type": "integer"
        }
      },
      "required": [
        "device",
        "inode",
        "uid"
      ],
      "title": "SharedTokenIdentity",
      "type": "object"
    },
    "WorkspaceIdentity": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "descriptor-workspace-v1",
          "default": "descriptor-workspace-v1",
          "title": "Version",
          "type": "string"
        },
        "path_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Path Sha256",
          "type": "string"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "owner_uid": {
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "path_sha256",
        "device",
        "inode",
        "owner_uid"
      ],
      "title": "WorkspaceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "2",
      "default": "2",
      "title": "Version",
      "type": "string"
    },
    "mode": {
      "const": "shared",
      "default": "shared",
      "title": "Mode",
      "type": "string"
    },
    "session": {
      "pattern": "^app-[a-f0-9]{32}$",
      "title": "Session",
      "type": "string"
    },
    "project": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project"
    },
    "url": {
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}/ui/$",
      "title": "Url",
      "type": "string"
    },
    "phase": {
      "enum": [
        "starting",
        "running",
        "stopping",
        "stopped",
        "uncertain"
      ],
      "title": "Phase",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "plan_path": {
      "title": "Plan Path",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "activation_path": {
      "title": "Activation Path",
      "type": "string"
    },
    "activation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Activation Sha256",
      "type": "string"
    },
    "provision_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provision Sha256",
      "type": "string"
    },
    "launch_intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Launch Intent Sha256",
      "type": "string"
    },
    "workspace": {
      "title": "Workspace",
      "type": "string"
    },
    "workspace_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "service_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/SharedServiceBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "token_name": {
      "anyOf": [
        {
          "pattern": "^desktop-console-[a-f0-9]{16}\\.token$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Name"
    },
    "token_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/SharedTokenIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionRuntimeBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ui_online": {
      "default": false,
      "title": "Ui Online",
      "type": "boolean"
    },
    "task_admission_enabled": {
      "default": false,
      "title": "Task Admission Enabled",
      "type": "boolean"
    },
    "cleanup_verified": {
      "default": false,
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "cleanup_evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleanup Evidence Sha256"
    },
    "last_error": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    }
  },
  "required": [
    "session",
    "url",
    "phase",
    "started_at",
    "plan_path",
    "plan_sha256",
    "activation_path",
    "activation_sha256",
    "provision_sha256",
    "launch_intent_sha256",
    "workspace"
  ],
  "title": "SharedDesktopState",
  "type": "object"
}
