{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "StageLineage": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "maximum": 3,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "open_app",
            "follow_draft",
            "fill_message",
            "submit_draft"
          ],
          "title": "Stage",
          "type": "string"
        },
        "state_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "State Sha256",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "call_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Call Ref",
          "type": "string"
        },
        "decision_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Decision Ref",
          "type": "string"
        },
        "action_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Action Ref",
          "type": "string"
        },
        "approval_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Approval Ref",
          "type": "string"
        },
        "verification_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Verification Ref",
          "type": "string"
        },
        "outcome_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Outcome Sha256",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "stage",
        "state_sha256",
        "input_sha256",
        "call_ref",
        "decision_ref",
        "action_ref",
        "approval_ref",
        "verification_ref",
        "outcome_sha256"
      ],
      "title": "StageLineage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_version": {
      "const": "synthetic-staging-s1-v1",
      "title": "Candidate Version",
      "type": "string"
    },
    "status": {
      "const": "unreviewed_candidate",
      "title": "Status",
      "type": "string"
    },
    "model_role": {
      "const": "system1",
      "title": "Model Role",
      "type": "string"
    },
    "model_kind": {
      "enum": [
        "decider_native_worker",
        "laya_candidate"
      ],
      "title": "Model Kind",
      "type": "string"
    },
    "run_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Run Ref",
      "type": "string"
    },
    "job_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Job Ref",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "deployment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Deployment Sha256",
      "type": "string"
    },
    "workflow_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Workflow Sha256",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StageLineage"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Steps",
      "type": "array"
    },
    "approved_action_count": {
      "const": 4,
      "title": "Approved Action Count",
      "type": "integer"
    },
    "independent_verification_count": {
      "const": 4,
      "title": "Independent Verification Count",
      "type": "integer"
    },
    "observed_submission_count": {
      "const": 1,
      "title": "Observed Submission Count",
      "type": "integer"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "profile_bound": {
      "const": false,
      "title": "Profile Bound",
      "type": "boolean"
    },
    "reviewed": {
      "const": false,
      "title": "Reviewed",
      "type": "boolean"
    },
    "execution_authorized": {
      "const": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "collection_authorized": {
      "const": false,
      "title": "Collection Authorized",
      "type": "boolean"
    },
    "activation_authorized": {
      "const": false,
      "title": "Activation Authorized",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "title": "Training Ready",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "candidate_version",
    "status",
    "model_role",
    "model_kind",
    "run_ref",
    "job_ref",
    "snapshot_sha256",
    "source_sha256",
    "deployment_sha256",
    "workflow_sha256",
    "steps",
    "approved_action_count",
    "independent_verification_count",
    "observed_submission_count",
    "synthetic",
    "profile_bound",
    "reviewed",
    "execution_authorized",
    "collection_authorized",
    "activation_authorized",
    "training_ready"
  ],
  "title": "StagingSkillCandidate",
  "type": "object"
}
