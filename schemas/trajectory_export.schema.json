{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS sanitized single-run trajectory export",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "redaction_version": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "goal_original": {
          "type": "string",
          "minLength": 1
        },
        "goal_normalized": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "task_id",
        "goal_original",
        "goal_normalized",
        "success_criteria"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "paused"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "deployment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 1
        },
        "environment": {
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "status",
        "outcome",
        "policy_version",
        "deployment_ids",
        "environment"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "snapshots": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/snapshot"
            },
            "minItems": 0
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/decision"
            },
            "minItems": 0
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            },
            "minItems": 0
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/observation"
            },
            "minItems": 0
          },
          "verifications": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/verification"
            },
            "minItems": 0
          },
          "escalations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/escalation"
            },
            "minItems": 0
          },
          "human_interventions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/intervention"
            },
            "minItems": 0
          },
          "model_calls": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/model_call"
            },
            "minItems": 0
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            },
            "minItems": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/label"
            },
            "minItems": 0
          }
        },
        "required": [
          "step_id",
          "ordinal",
          "snapshots",
          "decisions",
          "actions",
          "observations",
          "verifications",
          "escalations",
          "human_interventions",
          "model_calls",
          "artifacts",
          "labels"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "exported_at",
    "synthetic",
    "redaction_version",
    "task",
    "run",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "snapshot_id",
        "state_version",
        "state"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 10
        },
        "selected_option": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "policy_result": {
          "enum": [
            "allow",
            "deny",
            "approval",
            "escalate"
          ]
        }
      },
      "required": [
        "decision_id",
        "snapshot_id",
        "question",
        "options",
        "selected_option",
        "probabilities",
        "policy_result"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "denied",
            "cancelled",
            "uncertain"
          ]
        },
        "actual_option": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "action_id",
        "decision_id",
        "tool",
        "arguments",
        "idempotency_key",
        "status",
        "actual_option"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "action_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "observation_id",
        "action_id",
        "kind",
        "summary"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "verification_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "expected": {
          "type": ["string", "object"],
          "minLength": 1
        },
        "actual": {
          "type": ["string", "object"],
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "verification_id",
        "action_id",
        "criterion",
        "method",
        "result",
        "expected",
        "actual",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "properties": {
        "escalation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "diagnosis": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "outcome": {
          "enum": [
            "recovered",
            "failed",
            "human_required"
          ]
        }
      },
      "required": [
        "escalation_id",
        "reason",
        "diagnosis",
        "plan",
        "outcome"
      ],
      "additionalProperties": false
    },
    "intervention": {
      "type": "object",
      "properties": {
        "intervention_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "enum": [
            "approve",
            "reject",
            "correction",
            "take_control",
            "return_control",
            "pause",
            "resume",
            "stop"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "intervention_id",
        "kind",
        "summary"
      ],
      "additionalProperties": false
    },
    "model_call": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "role": {
          "enum": [
            "system1",
            "system2"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout",
            "cancelled"
          ]
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "call_id",
        "deployment_id",
        "role",
        "status",
        "latency_ms"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "redacted": {
          "type": "boolean"
        }
      },
      "required": [
        "artifact_id",
        "relative_path",
        "sha256",
        "media_type",
        "redacted"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "label_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "verification_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source": {
          "enum": [
            "verified_outcome",
            "human_review",
            "supervisor_verified"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label_id",
        "verification_ref",
        "source",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
