{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS bounded in-task remote route knowledge comparison event",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"status": {"const": "matched"}}},
             "then": {"not": {"required": ["stale_reason"]}}}],
  "required": ["review_sha256", "route_index", "status", "expected_fingerprint_sha256", "current_fingerprint_sha256", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "review_sha256": {"$ref": "#/$defs/checksum"},
    "route_index": {"type": "integer", "minimum": 0, "maximum": 7},
    "status": {"enum": ["matched", "stale"]},
    "stale_reason": {"enum": ["source_fingerprint_changed", "source_link_sample_changed",
                              "target_fingerprint_changed"]},
    "expected_fingerprint_sha256": {"$ref": "#/$defs/checksum"},
    "current_fingerprint_sha256": {"$ref": "#/$defs/checksum"},
    "link_sample_matched": {"type": "boolean"},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {"checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
