{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS unreviewed HTTPS JSON-bundle learning source audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "profile_sha256", "plan_sha256", "run_ref", "snapshot_sha256", "asset_count", "data_count", "requested_roles", "source_event_ids_by_role", "transport_readback_verified", "site_outcome_verified", "account_verified", "rights_reviewed", "redaction_reviewed", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_remote_json_bundle_source"},
    "status": {"const": "unreviewed_metadata_candidate"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "run_ref": {"$ref": "#/$defs/hash"},
    "snapshot_sha256": {"$ref": "#/$defs/hash"},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "data_count": {"type": "integer", "minimum": 1, "maximum": 4},
    "requested_roles": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["system1", "system2"]}},
    "source_event_ids_by_role": {
      "type": "object", "additionalProperties": false,
      "required": ["system1", "system2"],
      "properties": {
        "system1": {"$ref": "#/$defs/event_ids"},
        "system2": {"$ref": "#/$defs/event_ids"}
      }
    },
    "transport_readback_verified": {"const": true},
    "site_outcome_verified": {"const": false},
    "account_verified": {"const": false},
    "rights_reviewed": {"const": false},
    "redaction_reviewed": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_ids": {"type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^learning-[a-f0-9]{64}$"}}
  }
}
