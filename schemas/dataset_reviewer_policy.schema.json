{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS explicit local reviewer policy",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "grants": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "uid": {"type": "integer", "minimum": 0},
          "run_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
          "decisions": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
            "items": {"enum": ["accept", "revoke"]}},
          "expires_at": {"type": "number", "exclusiveMinimum": 0}
        },
        "required": ["uid", "run_ids", "decisions", "expires_at"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "grants"],
  "additionalProperties": false
}
