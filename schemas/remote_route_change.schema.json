{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS read-only historical HTTPS route change preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "fingerprint_version", "snapshot_sha256", "profile_sha256", "plan_sha256", "before_run_ref", "after_run_ref", "route_count", "routes", "profile_bound", "readback_verified", "origin_verified", "account_verified", "site_outcome_verified", "reviewed", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_remote_route_change"},
    "status": {"enum": ["unchanged_profile_bound", "changed_profile_bound"]},
    "fingerprint_version": {"const": "remote-route-readback-v1"},
    "snapshot_sha256": {"$ref": "#/$defs/checksum"},
    "profile_sha256": {"$ref": "#/$defs/checksum"},
    "plan_sha256": {"$ref": "#/$defs/checksum"},
    "before_run_ref": {"$ref": "#/$defs/checksum"},
    "after_run_ref": {"$ref": "#/$defs/checksum"},
    "route_count": {"type": "integer", "minimum": 2, "maximum": 8},
    "routes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [{"if": {"required": ["link_sample_sha256"]},
                   "then": {"required": ["sampled_link_inventory_changed", "planned_link_indices"],
                            "properties": {"sampled_link_inventory_changed": {"const": false}}}},
                  {"if": {"required": ["planned_link_indices"]},
                   "then": {"required": ["link_sample_sha256"]}}],
        "required": ["route_index", "url_sha256", "before_fingerprint_sha256", "after_fingerprint_sha256", "changed"],
        "properties": {
          "route_index": {"type": "integer", "minimum": 0, "maximum": 7},
          "url_sha256": {"$ref": "#/$defs/checksum"},
          "before_fingerprint_sha256": {"$ref": "#/$defs/checksum"},
          "after_fingerprint_sha256": {"$ref": "#/$defs/checksum"},
          "changed": {"type": "boolean"},
          "sampled_link_inventory_changed": {"type": "boolean"},
          "link_sample_sha256": {"$ref": "#/$defs/checksum"},
          "planned_link_indices": {"type": "array", "uniqueItems": true, "maxItems": 8,
                                   "items": {"type": "integer", "minimum": 0, "maximum": 7}}
        }
      }
    },
    "profile_bound": {"const": true},
    "readback_verified": {"const": true},
    "origin_verified": {"const": false},
    "account_verified": {"const": false},
    "site_outcome_verified": {"const": false},
    "reviewed": {"const": false},
    "task_retrieval_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
