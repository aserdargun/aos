{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS System-1 Choice",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "split_group": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source": {
          "enum": [
            "verified_outcome",
            "human_review",
            "supervisor_verified"
          ]
        },
        "verification_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "synthetic": {
          "type": "boolean"
        },
        "redaction_version": {
          "type": "string",
          "minLength": 1
        },
        "usage_rights": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "step_id",
        "source",
        "verification_ref",
        "synthetic",
        "redaction_version",
        "usage_rights"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 10
    },
    "prediction": {
      "type": "object",
      "properties": {
        "selected_option": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "probabilities": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "selected_option",
        "probabilities"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "correct_option": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "policy_reviewed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "correct_option",
        "outcome",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "created_at",
    "split_group",
    "provenance",
    "state",
    "question",
    "options",
    "prediction",
    "target"
  ],
  "additionalProperties": false
}
