{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS opt-in remote metadata stream report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "run_ref", "profile_sha256", "plan_sha256", "consent_sha256", "source_snapshot_sha256", "run_status", "roles", "new_entries", "total_entries", "entries_by_role", "polls", "metadata_only", "collection_granted_locally", "site_outcome_verified", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["opt_in_remote_metadata_poll", "opt_in_remote_metadata_watch"]},
    "run_ref": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "consent_sha256": {"$ref": "#/$defs/hash"},
    "source_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "run_status": {"enum": ["created", "running", "paused", "waiting_human", "succeeded", "failed", "cancelled"]},
    "roles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["system1", "system2"]}},
    "new_entries": {"type": "integer", "minimum": 0, "maximum": 500},
    "total_entries": {"type": "integer", "minimum": 0, "maximum": 500},
    "entries_by_role": {"type": "object", "additionalProperties": false, "required": ["system1", "system2"],
      "properties": {"system1": {"type": "integer", "minimum": 0, "maximum": 500}, "system2": {"type": "integer", "minimum": 0, "maximum": 500}}},
    "polls": {"type": "integer", "minimum": 1, "maximum": 1200},
    "metadata_only": {"const": true},
    "collection_granted_locally": {"const": true},
    "site_outcome_verified": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
