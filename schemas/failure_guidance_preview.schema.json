{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "HelloGuidanceFollowup": {
      "additionalProperties": false,
      "properties": {
        "manual_approval_required": {
          "const": true,
          "title": "Manual Approval Required",
          "type": "boolean"
        },
        "guidance_applied": {
          "const": false,
          "title": "Guidance Applied",
          "type": "boolean"
        },
        "causality_verified": {
          "const": false,
          "title": "Causality Verified",
          "type": "boolean"
        },
        "gold": {
          "const": false,
          "title": "Gold",
          "type": "boolean"
        },
        "training_ready": {
          "const": false,
          "title": "Training Ready",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^followup-[a-f0-9]{32}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "source_job_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Source Job Id",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/HelloGuidanceTarget"
        },
        "source_contract": {
          "$ref": "#/$defs/TaskContract"
        },
        "correction_code": {
          "enum": [
            "refresh_observation",
            "inspect_before_retry"
          ],
          "title": "Correction Code",
          "type": "string"
        },
        "confirm_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Confirm Sha256",
          "type": "string"
        }
      },
      "required": [
        "manual_approval_required",
        "guidance_applied",
        "causality_verified",
        "gold",
        "training_ready",
        "schema_version",
        "attempt_id",
        "source_job_id",
        "candidate_sha256",
        "receipt_sha256",
        "source_sha256",
        "target",
        "source_contract",
        "correction_code",
        "confirm_sha256"
      ],
      "title": "HelloGuidanceFollowup",
      "type": "object"
    },
    "HelloGuidanceTarget": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Session Id",
          "type": "string"
        },
        "parent_runtime_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Parent Runtime Id",
          "type": "string"
        },
        "image_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Lease Id",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "task_kind": {
          "const": "hello",
          "title": "Task Kind",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "system1_deployment_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "System1 Deployment Id",
          "type": "string"
        },
        "system2_deployment_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "System2 Deployment Id"
        }
      },
      "required": [
        "session_id",
        "parent_runtime_id",
        "image_id",
        "lease_id",
        "generation",
        "task_kind",
        "configuration_sha256",
        "system1_deployment_id",
        "system2_deployment_id"
      ],
      "title": "HelloGuidanceTarget",
      "type": "object"
    },
    "TaskContract": {
      "additionalProperties": false,
      "properties": {
        "semantic_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Semantic Sha256",
          "type": "string"
        },
        "binding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        }
      },
      "required": [
        "semantic_sha256",
        "binding_sha256"
      ],
      "title": "TaskContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manual_approval_required": {
      "const": true,
      "title": "Manual Approval Required",
      "type": "boolean"
    },
    "guidance_applied": {
      "const": false,
      "title": "Guidance Applied",
      "type": "boolean"
    },
    "causality_verified": {
      "const": false,
      "title": "Causality Verified",
      "type": "boolean"
    },
    "gold": {
      "const": false,
      "title": "Gold",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "title": "Training Ready",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "followup": {
      "$ref": "#/$defs/HelloGuidanceFollowup"
    },
    "guidance_code": {
      "enum": [
        "refresh_observation",
        "inspect_before_retry"
      ],
      "title": "Guidance Code",
      "type": "string"
    },
    "context_version": {
      "const": "hello-guidance-v1",
      "title": "Context Version",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "confirm_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Confirm Sha256",
      "type": "string"
    }
  },
  "required": [
    "manual_approval_required",
    "guidance_applied",
    "causality_verified",
    "gold",
    "training_ready",
    "schema_version",
    "followup",
    "guidance_code",
    "context_version",
    "context_sha256",
    "confirm_sha256"
  ],
  "title": "FailureGuidancePreview",
  "type": "object"
}
