{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS read-only observed HTTPS navigation graph candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "fingerprint_version", "snapshot_sha256", "profile_sha256", "plan_sha256", "before_run_ref", "after_run_ref", "route_count", "stable_pages", "observed_edges", "changed_route_indices", "incomplete_link_sample_indices", "profile_bound", "readback_verified", "semantic_page_keys_verified", "origin_verified", "account_verified", "site_outcome_verified", "reviewed", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_observed_navigation_graph"},
    "status": {"const": "candidate_observed_route_graph"},
    "fingerprint_version": {"const": "remote-route-readback-v1"},
    "snapshot_sha256": {"$ref": "#/$defs/checksum"},
    "profile_sha256": {"$ref": "#/$defs/checksum"},
    "plan_sha256": {"$ref": "#/$defs/checksum"},
    "before_run_ref": {"$ref": "#/$defs/checksum"},
    "after_run_ref": {"$ref": "#/$defs/checksum"},
    "route_count": {"type": "integer", "minimum": 2, "maximum": 8},
    "stable_pages": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false,
      "required": ["route_index", "url_sha256", "page_fingerprint_sha256"],
      "properties": {"route_index": {"$ref": "#/$defs/route_index"}, "url_sha256": {"$ref": "#/$defs/checksum"},
        "page_fingerprint_sha256": {"$ref": "#/$defs/checksum"}, "link_sample_sha256": {"$ref": "#/$defs/checksum"}}}},
    "observed_edges": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false,
      "required": ["source_route_index", "target_route_index"],
      "properties": {"source_route_index": {"$ref": "#/$defs/route_index"},
        "target_route_index": {"$ref": "#/$defs/route_index"}}}},
    "changed_route_indices": {"$ref": "#/$defs/route_indices"},
    "incomplete_link_sample_indices": {"$ref": "#/$defs/route_indices"},
    "profile_bound": {"const": true},
    "readback_verified": {"const": true},
    "semantic_page_keys_verified": {"const": false},
    "origin_verified": {"const": false},
    "account_verified": {"const": false},
    "site_outcome_verified": {"const": false},
    "reviewed": {"const": false},
    "task_retrieval_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "route_index": {"type": "integer", "minimum": 0, "maximum": 7},
    "route_indices": {"type": "array", "uniqueItems": true, "maxItems": 8,
      "items": {"$ref": "#/$defs/route_index"}}
  }
}
