{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-action owned adapter task admission observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "candidate_execution_sha256": {
      "$ref": "#/$defs/hash"
    },
    "preview_sha256": {
      "$ref": "#/$defs/hash"
    },
    "adapter_admission_sha256": {
      "$ref": "#/$defs/hash"
    },
    "reuse_admission_sha256": {
      "$ref": "#/$defs/hash"
    },
    "candidate_sha256": {
      "$ref": "#/$defs/hash"
    },
    "invocation_sha256": {
      "$ref": "#/$defs/hash"
    },
    "adaptation_report_sha256": {
      "$ref": "#/$defs/hash"
    },
    "adapter_sha256": {
      "$ref": "#/$defs/hash"
    },
    "runtime_binding_sha256": {
      "$ref": "#/$defs/hash"
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "manager_session": {
      "$ref": "#/$defs/id"
    },
    "desktop_session_id": {
      "$ref": "#/$defs/id"
    },
    "runtime_id": {
      "$ref": "#/$defs/id"
    },
    "lease_id": {
      "$ref": "#/$defs/id"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "adapter_deployment_id": {
      "type": "string",
      "pattern": "^owned-adapter-[a-f0-9]{64}$"
    },
    "experimental_runtime_authorized": {
      "const": true
    },
    "automatic_fallback": {
      "const": false
    },
    "promotion_authorized": {
      "const": false
    },
    "training_ready": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "candidate_execution_sha256",
    "preview_sha256",
    "adapter_admission_sha256",
    "reuse_admission_sha256",
    "candidate_sha256",
    "invocation_sha256",
    "adaptation_report_sha256",
    "adapter_sha256",
    "runtime_binding_sha256",
    "job_id",
    "run_id",
    "manager_session",
    "desktop_session_id",
    "runtime_id",
    "lease_id",
    "generation",
    "adapter_deployment_id",
    "experimental_runtime_authorized",
    "automatic_fallback",
    "promotion_authorized",
    "training_ready"
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  }
}
