    "recipe_execution_verified": {
      "const": true,
      "title": "Recipe Execution Verified",
      "type": "boolean"
    },
    "record_outcome_verified": {
      "const": true,
      "title": "Record Outcome Verified",
      "type": "boolean"
    }
