      "default": false,
      "title": "Site Outcome Verified",
      "type": "boolean"
    },
    "activation_authorized": {
      "const": false,
      "default": false,
      "title": "Activation Authorized",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "default": false,
      "title": "Training Ready",
      "type": "boolean"
    },
    "gpu_release_verified": {
      "const": false,
      "default": false,
      "title": "Gpu Release Verified",
      "type": "boolean"
    },
    "replay_authorized": {
      "const": false,
      "default": false,
      "title": "Replay Authorized",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "owned_parameter_project_manual_bootstrap_receipt",
      "title": "Kind",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "run_binding_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Run Binding Sha256",
      "type": "string"
    },
    "run_identity": {
      "$ref": "#/$defs/WebGoalExecutionRunIdentity"
    },
    "recipe_audit": {
      "$ref": "#/$defs/SiteSkillFormRecipeAuditReport"
    },
    "recipe_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Recipe Audit Sha256",
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/WebGoalWholeRecordObservation"
