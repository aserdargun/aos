    "kind",
    "intent_sha256",
    "run_binding_sha256",
    "run_identity",
    "recipe_audit",
    "recipe_audit_sha256",
    "observation",
    "observation_sha256",
    "terminal_status",
    "verification_scope",
    "task_terminal_verified",
    "recipe_execution_verified",
    "record_outcome_verified"
  ],
  "title": "OwnedParameterProjectExecutionReceipt",
  "type": "object"
}
