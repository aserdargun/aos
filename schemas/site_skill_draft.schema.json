{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "title": "Schema Version", "type": "string"},
    "profile_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Profile Sha256", "type": "string"},
    "application_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Application Key", "type": "string"},
    "tenant_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Tenant Key", "type": "string"},
    "account_role": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Account Role", "type": "string"},
    "task_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Task Key", "type": "string"},
    "page_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Page Key", "type": "string"},
    "page_draft_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Page Draft Sha256", "type": "string"},
    "skill_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Skill Key", "type": "string"},
    "model_role": {"enum": ["system1", "system2"], "title": "Model Role", "type": "string"},
    "candidate_kind": {"enum": ["finite_action_choice", "workflow_plan"], "title": "Candidate Kind", "type": "string"},
    "revision": {"maximum": 100, "minimum": 1, "title": "Revision", "type": "integer"},
    "previous_sha256": {"anyOf": [{"pattern": "^[a-f0-9]{64}$", "type": "string"}, {"type": "null"}], "title": "Previous Sha256"},
    "parameter_keys": {"items": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "type": "string"}, "maxItems": 16, "title": "Parameter Keys", "type": "array"},
    "precondition_keys": {"items": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "type": "string"}, "maxItems": 16, "title": "Precondition Keys", "type": "array"},
    "step_keys": {"items": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "type": "string"}, "maxItems": 16, "minItems": 1, "title": "Step Keys", "type": "array"},
    "expected_outcome_key": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "title": "Expected Outcome Key", "type": "string"},
    "source_event_ids": {"items": {"pattern": "^learning-[a-f0-9]{64}$", "type": "string"}, "maxItems": 32, "minItems": 1, "title": "Source Event Ids", "type": "array"},
    "source_verification_ids": {"items": {"pattern": "^[a-z][a-z0-9_-]{0,63}$", "type": "string"}, "maxItems": 32, "title": "Source Verification Ids", "type": "array"},
    "source_kind": {"const": "manual_candidate", "title": "Source Kind", "type": "string"},
    "status": {"const": "draft", "title": "Status", "type": "string"},
    "execution_authorized": {"const": false, "title": "Execution Authorized", "type": "boolean"},
    "collection_authorized": {"const": false, "title": "Collection Authorized", "type": "boolean"},
    "training_ready": {"const": false, "title": "Training Ready", "type": "boolean"},
    "activation_authorized": {"const": false, "title": "Activation Authorized", "type": "boolean"}
  },
  "required": ["schema_version", "profile_sha256", "application_key", "tenant_key", "account_role", "task_key", "page_key", "page_draft_sha256", "skill_key", "model_role", "candidate_kind", "revision", "previous_sha256", "parameter_keys", "precondition_keys", "step_keys", "expected_outcome_key", "source_event_ids", "source_verification_ids", "source_kind", "status", "execution_authorized", "collection_authorized", "training_ready", "activation_authorized"],
  "title": "SiteSkillDraft",
  "type": "object"
}
