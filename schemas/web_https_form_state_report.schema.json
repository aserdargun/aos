{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS bounded HTTPS form declared state readback report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "profile_sha256", "task_sha256", "form_plan_sha256", "state_plan_sha256", "state_url_sha256", "receipt_response_sha256", "before_response_sha256", "after_response_sha256", "before_response_bytes", "after_response_bytes", "tls_hostname_verified", "declared_response_transition_observed", "browser_connected", "account_verified", "site_outcome_verified", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "bounded_form_declared_state_readback"},
    "status": {"const": "declared_response_transition_observed"},
    "profile_sha256": {"$ref": "#/$defs/checksum"},
    "task_sha256": {"$ref": "#/$defs/checksum"},
    "form_plan_sha256": {"$ref": "#/$defs/checksum"},
    "state_plan_sha256": {"$ref": "#/$defs/checksum"},
    "state_url_sha256": {"$ref": "#/$defs/checksum"},
    "receipt_response_sha256": {"$ref": "#/$defs/checksum"},
    "before_response_sha256": {"$ref": "#/$defs/checksum"},
    "after_response_sha256": {"$ref": "#/$defs/checksum"},
    "before_response_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "after_response_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "marker_id_sha256": {"$ref": "#/$defs/checksum"},
    "before_marker_sha256": {"$ref": "#/$defs/checksum"},
    "after_marker_sha256": {"$ref": "#/$defs/checksum"},
    "declared_marker_transition_observed": {"const": true},
    "submitted_field_name_sha256": {"$ref": "#/$defs/checksum"},
    "submitted_value_readback_verified": {"const": true},
    "tls_hostname_verified": {"const": true},
    "declared_response_transition_observed": {"const": true},
    "browser_connected": {"const": false},
    "account_verified": {"const": false},
    "site_outcome_verified": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "dependentRequired": {
    "marker_id_sha256": ["before_marker_sha256", "after_marker_sha256", "declared_marker_transition_observed"],
    "before_marker_sha256": ["marker_id_sha256", "after_marker_sha256", "declared_marker_transition_observed"],
    "after_marker_sha256": ["marker_id_sha256", "before_marker_sha256", "declared_marker_transition_observed"],
    "declared_marker_transition_observed": ["marker_id_sha256", "before_marker_sha256", "after_marker_sha256"],
    "submitted_field_name_sha256": ["submitted_value_readback_verified", "marker_id_sha256"],
    "submitted_value_readback_verified": ["submitted_field_name_sha256", "marker_id_sha256"]
  },
  "$defs": {"checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
