{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owned_episode_candidate.schema.json",
  "title": "Source-bound owned episode model-content candidate; unreviewed and non-training",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0"},
        "synthetic": {"const": true},
        "candidate_id": {"$ref": "#/$defs/hash"},
        "episode_id": {"type": "string", "pattern": "^episode-[a-f0-9]{32}$"},
        "consent_sha256": {"$ref": "#/$defs/hash"},
        "source_group_sha256": {"$ref": "#/$defs/hash"},
        "role": {"const": "system1"},
        "source": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "run_ref": {"$ref": "#/$defs/hash"},
            "step_ref": {"$ref": "#/$defs/hash"},
            "call_ref": {"$ref": "#/$defs/hash"},
            "decision_ref": {"$ref": "#/$defs/hash"},
            "state_snapshot_ref": {"$ref": "#/$defs/hash"},
            "planning_bundle_sha256": {"$ref": "#/$defs/hash"},
            "deployment_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "deployment_sha256": {"$ref": "#/$defs/hash"}
          },
          "required": ["run_ref", "step_ref", "call_ref", "decision_ref", "state_snapshot_ref", "planning_bundle_sha256", "deployment_id", "deployment_sha256"]
        },
        "input": {"$ref": "#/$defs/system1Input"},
        "prediction": {"$ref": "#/$defs/prediction"},
        "reviewed": {"const": false},
        "execution_authorized": {"const": false},
        "collection_authorized": {"const": false},
        "activation_authorized": {"const": false},
        "training_ready": {"const": false}
      },
      "required": ["schema_version", "synthetic", "candidate_id", "episode_id", "consent_sha256", "source_group_sha256", "role", "source", "input", "prediction", "reviewed", "execution_authorized", "collection_authorized", "activation_authorized", "training_ready"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "1.0"},
        "synthetic": {"const": true},
        "candidate_id": {"$ref": "#/$defs/hash"},
        "episode_id": {"type": "string", "pattern": "^episode-[a-f0-9]{32}$"},
        "consent_sha256": {"$ref": "#/$defs/hash"},
        "source_group_sha256": {"$ref": "#/$defs/hash"},
        "role": {"const": "system2"},
        "source": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "planning_id": {"type": "string", "pattern": "^planning-[a-f0-9]{32}$"},
            "planning_bundle_sha256": {"$ref": "#/$defs/hash"},
            "deployment_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "deployment_sha256": {"$ref": "#/$defs/hash"}
          },
          "required": ["planning_id", "planning_bundle_sha256", "deployment_id", "deployment_sha256"]
        },
        "input": {"$ref": "#/$defs/system2Input"},
        "prediction": {"$ref": "#/$defs/ownedSkillPlan"},
        "reviewed": {"const": false},
        "execution_authorized": {"const": false},
        "collection_authorized": {"const": false},
        "activation_authorized": {"const": false},
        "training_ready": {"const": false}
      },
      "required": ["schema_version", "synthetic", "candidate_id", "episode_id", "consent_sha256", "source_group_sha256", "role", "source", "input", "prediction", "reviewed", "execution_authorized", "collection_authorized", "activation_authorized", "training_ready"]
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "option": {
      "type": "object", "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}},
      "required": ["id", "label"]
    },
    "system1Input": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "request_sha256": {"$ref": "#/$defs/hash"},
        "request": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "state": {"type": "string"},
            "question": {"type": "string"},
            "options": {"type": "array", "items": {"$ref": "#/$defs/option"}, "minItems": 2, "maxItems": 10}
          },
          "required": ["state", "question", "options"]
        }
      },
      "required": ["request", "request_sha256"]
    },
    "system2Input": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "request_sha256": {"$ref": "#/$defs/hash"},
        "request": {"type": "object"}
      },
      "required": ["request", "request_sha256"]
    },
    "prediction": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "selected_option": {"type": "string"},
        "probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
      },
      "required": ["selected_option", "probabilities"]
    },
    "planStep": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "step_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "operation": {"type": "string", "enum": ["open_entry", "read_state_before", "fill_form", "submit_form", "read_receipt", "read_state_after"]}
      },
      "required": ["step_key", "operation"]
    },
    "ownedSkillPlan": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "schema_version": {"const": "1.0"}, "decision": {"const": "invoke_selected_skill"},
            "evidence_refs": {"const": ["admitted-skill"]},
            "case_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
            "parameter_value": {"type": "string", "pattern": "^[A-Za-z0-9 _.-]{1,128}$"},
            "steps": {"type": "array", "items": {"$ref": "#/$defs/planStep"}, "minItems": 6, "maxItems": 6},
            "reason_code": {"const": "skill_match"},
            "execution_authorized": {"const": false}, "activation_authorized": {"const": false},
            "training_ready": {"const": false}
          },
          "required": ["schema_version", "decision", "evidence_refs", "case_key", "parameter_value", "steps", "reason_code", "execution_authorized", "activation_authorized", "training_ready"]
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "schema_version": {"const": "1.0"}, "decision": {"const": "needs_human"},
            "evidence_refs": {"const": ["admitted-skill"]}, "case_key": {"type": "null"},
            "parameter_value": {"type": "null"}, "steps": {"const": []},
            "reason_code": {"type": "string", "enum": ["skill_not_applicable", "input_ambiguous", "evidence_insufficient", "safety_unclear"]},
            "execution_authorized": {"const": false}, "activation_authorized": {"const": false},
            "training_ready": {"const": false}
          },
          "required": ["schema_version", "decision", "evidence_refs", "case_key", "parameter_value", "steps", "reason_code", "execution_authorized", "activation_authorized", "training_ready"]
        }
      ]
    }
  }
}
