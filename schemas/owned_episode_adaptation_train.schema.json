{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owned_episode_adaptation_train.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_revision",
    "code_revision",
    "weights_sha256",
    "manifest_sha256",
    "input_sha256",
    "authorization_sha256",
    "conversion_sha256",
    "development_decisions",
    "token_budget",
    "base_parameters_unchanged",
    "base_gradient_count",
    "training_ready",
    "mode",
    "adapter_target",
    "adapter_rank",
    "adapter_parameter_count",
    "seed",
    "optimizer_step_count",
    "learning_rate",
    "development_nll_before",
    "development_nll_after",
    "gradient_norm",
    "peak_vram_allocated_bytes",
    "peak_vram_reserved_bytes",
    "elapsed_seconds",
    "adapter_parameters_changed",
    "candidate_checkpoint_written",
    "candidate_artifact_sha256",
    "candidate_artifact_bytes"
  ],
  "properties": {
    "checkpoint_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "code_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "weights_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conversion_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "development_decisions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "token_budget": {
      "const": 1536
    },
    "base_parameters_unchanged": {
      "const": true
    },
    "base_gradient_count": {
      "const": 0
    },
    "training_ready": {
      "const": false
    },
    "mode": {
      "const": "owned_episode_adapter_train_v1"
    },
    "adapter_target": {
      "const": "last_mlp_down_proj"
    },
    "adapter_rank": {
      "const": 4
    },
    "adapter_parameter_count": {
      "const": 32768
    },
    "seed": {
      "const": 42
    },
    "optimizer_step_count": {
      "const": 1
    },
    "learning_rate": {
      "const": 0.1
    },
    "development_nll_before": {
      "type": "number",
      "minimum": 0
    },
    "development_nll_after": {
      "type": "number",
      "minimum": 0
    },
    "gradient_norm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "peak_vram_allocated_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "peak_vram_reserved_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "elapsed_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "adapter_parameters_changed": {
      "const": true
    },
    "candidate_checkpoint_written": {
      "const": true
    },
    "candidate_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_artifact_bytes": {
      "const": 131188
    }
  }
}
