{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS Registry Snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "backend": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "source",
          "revision",
          "sha256",
          "backend",
          "capabilities",
          "enabled",
          "metadata"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "base_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "compatibility": {
            "enum": [
              "unknown",
              "passed",
              "failed"
            ]
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "model_id",
          "base_sha256",
          "sha256",
          "compatibility",
          "metadata"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "adapter_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "EXPERIMENTAL",
              "CANDIDATE",
              "VALIDATED",
              "ACTIVE",
              "DEPRECATED",
              "REJECTED"
            ]
          },
          "config": {
            "type": "object"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "model_id",
          "adapter_id",
          "status",
          "config",
          "config_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "deployment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "suite_version": {
            "type": "string",
            "minLength": 1
          },
          "suite_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "incomplete"
            ]
          },
          "metrics": {
            "type": "object"
          },
          "environment": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "deployment_id",
          "suite_version",
          "suite_sha256",
          "status",
          "metrics",
          "environment"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "models",
    "adapters",
    "deployments",
    "benchmarks"
  ],
  "additionalProperties": false
}
