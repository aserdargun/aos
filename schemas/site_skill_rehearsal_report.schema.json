{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "title": "Schema Version", "type": "string"},
    "synthetic": {"const": true, "title": "Synthetic", "type": "boolean"},
    "status": {"const": "source_request_bound_parameter_unbound", "title": "Status", "type": "string"},
    "skill_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Skill Sha256", "type": "string"},
    "plan_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Plan Sha256", "type": "string"},
    "run_ref": {"pattern": "^[a-f0-9]{64}$", "title": "Run Ref", "type": "string"},
    "snapshot_sha256": {"pattern": "^[a-f0-9]{64}$", "title": "Snapshot Sha256", "type": "string"},
    "model_role": {"enum": ["system1", "system2"], "title": "Model Role", "type": "string"},
    "source_event_count": {"maximum": 32, "minimum": 1, "title": "Source Event Count", "type": "integer"},
    "source_variant_count": {"maximum": 16, "minimum": 1, "title": "Source Variant Count", "type": "integer"},
    "development_count": {"maximum": 14, "minimum": 1, "title": "Development Count", "type": "integer"},
    "held_out_count": {"maximum": 15, "minimum": 2, "title": "Held Out Count", "type": "integer"},
    "source_inspection_status": {"const": "unreviewed_source_match", "title": "Source Inspection Status", "type": "string"},
    "structural_status": {"const": "structure_only", "title": "Structural Status", "type": "string"},
    "source_request_bound": {"const": true, "title": "Source Request Bound", "type": "boolean"},
    "source_variant_bound": {"const": false, "title": "Source Variant Bound", "type": "boolean"},
    "held_out_separated_structurally": {"const": true, "title": "Held Out Separated Structurally", "type": "boolean"},
    "execution_performed": {"const": false, "title": "Execution Performed", "type": "boolean"},
    "outcomes_verified": {"const": false, "title": "Outcomes Verified", "type": "boolean"},
    "skill_validated": {"const": false, "title": "Skill Validated", "type": "boolean"},
    "reviewed": {"const": false, "title": "Reviewed", "type": "boolean"},
    "activation_authorized": {"const": false, "title": "Activation Authorized", "type": "boolean"},
    "training_ready": {"const": false, "title": "Training Ready", "type": "boolean"}
  },
  "required": ["schema_version", "synthetic", "status", "skill_sha256", "plan_sha256", "run_ref", "snapshot_sha256", "model_role", "source_event_count", "source_variant_count", "development_count", "held_out_count", "source_inspection_status", "structural_status", "source_request_bound", "source_variant_bound", "held_out_separated_structurally", "execution_performed", "outcomes_verified", "skill_validated", "reviewed", "activation_authorized", "training_ready"],
  "title": "SiteSkillRehearsalReport",
  "type": "object"
}
