{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owned_episode_adaptation_replay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_revision",
    "code_revision",
    "weights_sha256",
    "manifest_sha256",
    "input_sha256",
    "authorization_sha256",
    "conversion_sha256",
    "development_decisions",
    "token_budget",
    "base_parameters_unchanged",
    "base_gradient_count",
    "training_ready",
    "mode",
    "artifact_sha256",
    "base_development_nll",
    "candidate_development_nll",
    "base_development_accuracy",
    "candidate_development_accuracy",
    "candidate_loaded",
    "evaluation"
  ],
  "properties": {
    "checkpoint_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "code_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "weights_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conversion_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "development_decisions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "token_budget": {
      "const": 1536
    },
    "base_parameters_unchanged": {
      "const": true
    },
    "base_gradient_count": {
      "const": 0
    },
    "training_ready": {
      "const": false
    },
    "mode": {
      "const": "owned_episode_adapter_replay_v1"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_development_nll": {
      "type": "number",
      "minimum": 0
    },
    "candidate_development_nll": {
      "type": "number",
      "minimum": 0
    },
    "base_development_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_development_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "candidate_loaded": {
      "const": true
    },
    "evaluation": {
      "const": "resubstitution"
    }
  }
}
