{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "KnowledgeScope": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Application Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "account_role": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Account Role",
          "type": "string"
        }
      },
      "required": [
        "application_id",
        "tenant_id",
        "account_role"
      ],
      "title": "KnowledgeScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/KnowledgeScope"
    },
    "document_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Document Sha256",
      "type": "string"
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "revoke"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "document_sha256",
    "decision"
  ],
  "title": "ReviewPreviewRequest",
  "type": "object"
}
