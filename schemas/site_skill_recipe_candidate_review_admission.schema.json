{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned candidate review admission observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "synthetic": {"const": true, "type": "boolean"},
    "review_sha256": {"$ref": "#/$defs/checksum"},
    "candidate_execution_sha256": {"$ref": "#/$defs/checksum"},
    "candidate_sha256": {"$ref": "#/$defs/checksum"},
    "source_run_ref": {"$ref": "#/$defs/checksum"},
    "review_status": {"const": "accepted", "type": "string"},
    "review_admission_verified": {"const": true, "type": "boolean"},
    "activation_authorized": {"const": false, "type": "boolean"},
    "training_ready": {"const": false, "type": "boolean"},
    "independent_held_out": {"const": false, "type": "boolean"}
  },
  "required": ["schema_version", "synthetic", "review_sha256",
    "candidate_execution_sha256", "candidate_sha256", "source_run_ref",
    "review_status", "review_admission_verified", "activation_authorized",
    "training_ready", "independent_held_out"],
  "$defs": {"checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
