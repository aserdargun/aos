{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private owned candidate execution completion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "type": "boolean"
    },
    "mode": {
      "const": "owned_candidate_development",
      "type": "string"
    },
    "candidate_execution_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "invocation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "status": {
      "const": "succeeded",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "mode",
    "candidate_execution_sha256",
    "candidate_sha256",
    "invocation_sha256",
    "run_ref",
    "job_id",
    "run_id",
    "status"
  ]
}
