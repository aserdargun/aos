{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS JSON-bundle metadata review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "review_sha256", "candidate_sha256", "metadata_reviewed", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "manual_remote_json_metadata_review"},
    "status": {"const": "metadata_review_recorded"},
    "review_sha256": {"$ref": "#/$defs/hash"},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "metadata_reviewed": {"const": true},
    "task_retrieval_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
