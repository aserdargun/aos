{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteFormStateRepeatReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "profile_sha256", "plan_sha256", "state_plan_sha256", "snapshot_sha256", "deployment_snapshot_sha256", "bound_attempts", "transport_verified", "failed_or_cancelled", "elapsed_p50_ms", "elapsed_p95_ms", "approval_window_count", "approval_window_sum_ms", "elapsed_excluding_approval_p50_ms", "elapsed_excluding_approval_p95_ms", "first_action_samples", "first_action_p50_ms", "first_action_p95_ms", "model_call_count", "model_latency_samples", "model_latency_sum_ms", "post_approval_stage_ms", "site_outcome_verified", "real_site_acceptance"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "mode": {"const": "read_only_post_admission_form_state_repeats"},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deployment_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bound_attempts": {"type": "integer", "minimum": 2, "maximum": 32},
    "transport_verified": {"type": "integer", "minimum": 0, "maximum": 32},
    "failed_or_cancelled": {"type": "integer", "minimum": 0, "maximum": 32},
    "elapsed_p50_ms": {"type": "number", "minimum": 0},
    "elapsed_p95_ms": {"type": "number", "minimum": 0},
    "approval_window_count": {"type": "integer", "minimum": 0, "maximum": 192},
    "approval_window_sum_ms": {"type": "number", "minimum": 0},
    "elapsed_excluding_approval_p50_ms": {"type": "number", "minimum": 0},
    "elapsed_excluding_approval_p95_ms": {"type": "number", "minimum": 0},
    "first_action_samples": {"type": "integer", "minimum": 0, "maximum": 32},
    "first_action_p50_ms": {"type": ["number", "null"], "minimum": 0},
    "first_action_p95_ms": {"type": ["number", "null"], "minimum": 0},
    "model_call_count": {"type": "integer", "minimum": 0, "maximum": 8192},
    "model_latency_samples": {"type": "integer", "minimum": 0, "maximum": 8192},
    "model_latency_sum_ms": {"type": "number", "minimum": 0},
    "post_approval_stage_ms": {"type": "object", "additionalProperties": false,
      "properties": {
        "browser.form.open": {"$ref": "#/$defs/stage_timing"},
        "browser.form.state_before": {"$ref": "#/$defs/stage_timing"},
        "browser.form.fill": {"$ref": "#/$defs/stage_timing"},
        "browser.form.submit": {"$ref": "#/$defs/stage_timing"},
        "browser.form.receipt": {"$ref": "#/$defs/stage_timing"},
        "browser.form.state_after": {"$ref": "#/$defs/stage_timing"}
      }},
    "site_outcome_verified": {"const": false},
    "real_site_acceptance": {"const": false}
  },
  "allOf": [{"if": {"properties": {"transport_verified": {"const": 0}}},
    "then": {"properties": {"post_approval_stage_ms": {"maxProperties": 0}}},
    "else": {"properties": {"post_approval_stage_ms": {
      "required": ["browser.form.open", "browser.form.state_before", "browser.form.fill",
        "browser.form.submit", "browser.form.receipt", "browser.form.state_after"],
      "minProperties": 6, "maxProperties": 6}}}}],
  "$defs": {"stage_timing": {"type": "object", "additionalProperties": false,
    "required": ["samples", "p50_ms", "p95_ms"],
    "properties": {"samples": {"type": "integer", "minimum": 1, "maximum": 32},
      "p50_ms": {"type": "number", "minimum": 0},
      "p95_ms": {"type": "number", "minimum": 0}}}}
}
