{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.1"},
    "mode": {"const": "web_application_draft_capabilities"},
    "static_asset_content_types": {"const": ["text/css", "text/javascript", "application/javascript", "image/png", "image/jpeg", "image/webp", "image/gif"]},
    "static_asset_canonical_query": {"const": true}
  },
  "required": ["schema_version", "mode", "static_asset_content_types", "static_asset_canonical_query"]
}
