{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ProcessIdentity": {
      "additionalProperties": false,
      "properties": {
        "boot_id": {
          "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
          "title": "Boot Id",
          "type": "string"
        },
        "pid": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Pid",
          "type": "integer"
        },
        "start_ticks": {
          "minimum": 1,
          "title": "Start Ticks",
          "type": "integer"
        },
        "pid_namespace": {
          "minimum": 1,
          "title": "Pid Namespace",
          "type": "integer"
        },
        "uid": {
          "minimum": 1,
          "title": "Uid",
          "type": "integer"
        }
      },
      "required": [
        "boot_id",
        "pid",
        "start_ticks",
        "pid_namespace",
        "uid"
      ],
      "title": "ProcessIdentity",
      "type": "object"
    },
    "SharedDrainObservation": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/SharedDrainRequest"
        },
        "admission_closed": {
          "title": "Admission Closed",
          "type": "boolean"
        },
        "local_controls_drained": {
          "title": "Local Controls Drained",
          "type": "boolean"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Blockers",
          "type": "array"
        },
        "cleanup_controls_closed": {
          "default": false,
          "title": "Cleanup Controls Closed",
          "type": "boolean"
        },
        "gpu_release_verified": {
          "const": false,
          "default": false,
          "title": "Gpu Release Verified",
          "type": "boolean"
        },
        "remote_jobs_stopped_verified": {
          "const": false,
          "default": false,
          "title": "Remote Jobs Stopped Verified",
          "type": "boolean"
        },
        "native_gpu_excluded": {
          "const": false,
          "default": false,
          "title": "Native Gpu Excluded",
          "type": "boolean"
        }
      },
      "required": [
        "request",
        "admission_closed",
        "local_controls_drained",
        "blockers"
      ],
      "title": "SharedDrainObservation",
      "type": "object"
    },
    "SharedDrainReceipt": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "process": {
          "$ref": "#/$defs/ProcessIdentity"
        },
        "observation": {
          "$ref": "#/$defs/SharedDrainObservation"
        }
      },
      "required": [
        "process",
        "observation"
      ],
      "title": "SharedDrainReceipt",
      "type": "object"
    },
    "SharedDrainRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^desktop-session-[a-f0-9]{32}$",
          "title": "Session Id",
          "type": "string"
        },
        "runtime_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Id",
          "type": "string"
        },
        "owner": {
          "const": "AGENT",
          "title": "Owner",
          "type": "string"
        },
        "lease_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Lease Id",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "runtime_id",
        "owner",
        "lease_id",
        "generation"
      ],
      "title": "SharedDrainRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "pattern": "^event-[a-f0-9]{32}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/SharedDrainReceipt"
    }
  },
  "required": [
    "receipt_id",
    "receipt_sha256",
    "receipt"
  ],
  "title": "SavedSharedDrainObservation",
  "type": "object"
}
