{
  "$defs": {
    "NativeInhibitFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "owner_uid": {
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "device",
        "inode",
        "owner_uid"
      ],
      "title": "NativeInhibitFileIdentity",
      "type": "object"
    },
    "NativeInhibitStoreRecord": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^native-[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Scope Id",
          "type": "string"
        },
        "directory": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Directory",
          "type": "string"
        },
        "directory_identity": {
          "$ref": "#/$defs/WorkspaceIdentity"
        },
        "lock_identity": {
          "$ref": "#/$defs/NativeInhibitFileIdentity"
        },
        "metadata_identity": {
          "$ref": "#/$defs/NativeInhibitFileIdentity"
        },
        "initial_lock_mtime_ns": {
          "minimum": 0,
          "title": "Initial Lock Mtime Ns",
          "type": "integer"
        },
        "initial_lock_ctime_ns": {
          "minimum": 0,
          "title": "Initial Lock Ctime Ns",
          "type": "integer"
        }
      },
      "required": [
        "scope_id",
        "directory",
        "directory_identity",
        "lock_identity",
        "metadata_identity",
        "initial_lock_mtime_ns",
        "initial_lock_ctime_ns"
      ],
      "title": "NativeInhibitStoreRecord",
      "type": "object"
    },
    "WorkspaceIdentity": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "descriptor-workspace-v1",
          "default": "descriptor-workspace-v1",
          "title": "Version",
          "type": "string"
        },
        "path_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Path Sha256",
          "type": "string"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "owner_uid": {
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "path_sha256",
        "device",
        "inode",
        "owner_uid"
      ],
      "title": "WorkspaceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record": {
      "$ref": "#/$defs/NativeInhibitStoreRecord"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "record",
    "content_sha256"
  ],
  "title": "NativeInhibitStore",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
