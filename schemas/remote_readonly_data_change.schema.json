{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS read-only historical HTTPS JSON-bundle transport change",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "fingerprint_version", "snapshot_sha256", "profile_sha256", "plan_sha256", "before_run_ref", "after_run_ref", "asset_count", "data_count", "before_fingerprint_sha256", "after_fingerprint_sha256", "entry_response_changed", "page_identity_changed", "asset_changed_indices", "data_changed_indices", "profile_bound", "transport_readback_verified", "site_outcome_verified", "account_verified", "rights_reviewed", "reviewed", "task_retrieval_authorized", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_remote_json_bundle_change"},
    "status": {"enum": ["changed_profile_bound", "unchanged_profile_bound"]},
    "fingerprint_version": {"const": "remote-json-bundle-transport-v1"},
    "snapshot_sha256": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "before_run_ref": {"$ref": "#/$defs/hash"},
    "after_run_ref": {"$ref": "#/$defs/hash"},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "data_count": {"type": "integer", "minimum": 1, "maximum": 4},
    "before_fingerprint_sha256": {"$ref": "#/$defs/hash"},
    "after_fingerprint_sha256": {"$ref": "#/$defs/hash"},
    "entry_response_changed": {"type": "boolean"},
    "page_identity_changed": {"type": "boolean"},
    "asset_changed_indices": {"type": "array", "uniqueItems": true, "maxItems": 8,
      "items": {"type": "integer", "minimum": 0, "maximum": 7}},
    "data_changed_indices": {"type": "array", "uniqueItems": true, "maxItems": 4,
      "items": {"type": "integer", "minimum": 0, "maximum": 3}},
    "profile_bound": {"const": true},
    "transport_readback_verified": {"const": true},
    "site_outcome_verified": {"const": false},
    "account_verified": {"const": false},
    "rights_reviewed": {"const": false},
    "reviewed": {"const": false},
    "task_retrieval_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
