{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owned_episode_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "consent_sha256",
    "role",
    "candidate_sha256",
    "execution",
    "source_group_sha256",
    "decision",
    "reviewer",
    "reference_policy",
    "synthetic",
    "training_ready"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^episode-[a-f0-9]{32}$"
    },
    "consent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "enum": [
        "system1",
        "system2"
      ]
    },
    "candidate_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_execution_sha256",
        "planning_bundle_sha256",
        "execution_source_sha256"
      ],
      "properties": {
        "candidate_execution_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planning_bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_group_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "reviewer": {
      "const": "authenticated_local_user"
    },
    "reference_policy": {
      "const": "human_reviewed_exact_prediction"
    },
    "synthetic": {
      "const": true
    },
    "training_ready": {
      "const": false
    }
  }
}
