{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnswerAuthority": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Lease Id",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "lease_id",
        "generation"
      ],
      "title": "AnswerAuthority",
      "type": "object"
    },
    "KnowledgeAnswerBundle": {
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "const": true,
          "title": "Untrusted",
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "training_ready": {
          "const": false,
          "title": "Training Ready",
          "type": "boolean"
        },
        "gold": {
          "const": false,
          "title": "Gold",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_answer_bundle",
          "title": "Kind",
          "type": "string"
        },
        "answer_id": {
          "pattern": "^answer-[a-f0-9]{32}$",
          "title": "Answer Id",
          "type": "string"
        },
        "preview": {
          "$ref": "#/$defs/KnowledgeAnswerPreview"
        },
        "consent": {
          "additionalProperties": true,
          "title": "Consent",
          "type": "object"
        },
        "deployment": {
          "additionalProperties": true,
          "title": "Deployment",
          "type": "object"
        },
        "authority": {
          "$ref": "#/$defs/AnswerAuthority"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "model_request": {
          "additionalProperties": true,
          "title": "Model Request",
          "type": "object"
        },
        "model_response": {
          "additionalProperties": true,
          "title": "Model Response",
          "type": "object"
        },
        "real_model": {
          "title": "Real Model",
          "type": "boolean"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "citation_binding_verified": {
          "const": true,
          "title": "Citation Binding Verified",
          "type": "boolean"
        },
        "semantic_relevance_verified": {
          "const": false,
          "title": "Semantic Relevance Verified",
          "type": "boolean"
        }
      },
      "required": [
        "untrusted",
        "execution_authorized",
        "training_ready",
        "gold",
        "schema_version",
        "kind",
        "answer_id",
        "preview",
        "consent",
        "deployment",
        "authority",
        "evidence",
        "model_request",
        "model_response",
        "real_model",
        "synthetic",
        "citation_binding_verified",
        "semantic_relevance_verified"
      ],
      "title": "KnowledgeAnswerBundle",
      "type": "object"
    },
    "KnowledgeAnswerPreview": {
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "const": true,
          "title": "Untrusted",
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "training_ready": {
          "const": false,
          "title": "Training Ready",
          "type": "boolean"
        },
        "gold": {
          "const": false,
          "title": "Gold",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_answer_preview",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/KnowledgeScope"
        },
        "question": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "top_k": {
          "maximum": 8,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "context_chars": {
          "maximum": 8192,
          "minimum": 256,
          "title": "Context Chars",
          "type": "integer"
        },
        "retrieval": {
          "$ref": "#/$defs/KnowledgeSearch"
        },
        "deployment": {
          "additionalProperties": true,
          "title": "Deployment",
          "type": "object"
        },
        "authority": {
          "$ref": "#/$defs/AnswerAuthority"
        },
        "store_identity": {
          "$ref": "#/$defs/StoreIdentity"
        },
        "confirm_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Confirm Sha256",
          "type": "string"
        }
      },
      "required": [
        "untrusted",
        "execution_authorized",
        "training_ready",
        "gold",
        "schema_version",
        "kind",
        "scope",
        "question",
        "top_k",
        "context_chars",
        "retrieval",
        "deployment",
        "authority",
        "store_identity",
        "confirm_sha256"
      ],
      "title": "KnowledgeAnswerPreview",
      "type": "object"
    },
    "KnowledgeHit": {
      "additionalProperties": false,
      "properties": {
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "review_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Review Sha256",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "revision": {
          "maximum": 32,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "chunk_index": {
          "maximum": 31,
          "minimum": 0,
          "title": "Chunk Index",
          "type": "integer"
        },
        "chunk_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "start": {
          "maximum": 32767,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 32768,
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "score": {
          "maximum": 512,
          "minimum": 1,
          "title": "Score",
          "type": "integer"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "document_sha256",
        "content_sha256",
        "review_sha256",
        "source_id",
        "title",
        "revision",
        "chunk_index",
        "chunk_sha256",
        "start",
        "end",
        "text",
        "score",
        "synthetic"
      ],
      "title": "KnowledgeHit",
      "type": "object"
    },
    "KnowledgeScope": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Application Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "account_role": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Account Role",
          "type": "string"
        }
      },
      "required": [
        "application_id",
        "tenant_id",
        "account_role"
      ],
      "title": "KnowledgeScope",
      "type": "object"
    },
    "KnowledgeSearch": {
      "additionalProperties": false,
      "properties": {
        "untrusted": {
          "const": true,
          "title": "Untrusted",
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "training_ready": {
          "const": false,
          "title": "Training Ready",
          "type": "boolean"
        },
        "gold": {
          "const": false,
          "title": "Gold",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_search",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/KnowledgeScope"
        },
        "query_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "method": {
          "const": "deterministic_lexical",
          "title": "Method",
          "type": "string"
        },
        "top_k": {
          "maximum": 8,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "context_chars": {
          "maximum": 8192,
          "minimum": 256,
          "title": "Context Chars",
          "type": "integer"
        },
        "used_context_chars": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Used Context Chars",
          "type": "integer"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/KnowledgeHit"
          },
          "maxItems": 8,
          "title": "Hits",
          "type": "array"
        }
      },
      "required": [
        "untrusted",
        "execution_authorized",
        "training_ready",
        "gold",
        "schema_version",
        "kind",
        "scope",
        "query_sha256",
        "method",
        "top_k",
        "context_chars",
        "used_context_chars",
        "hits"
      ],
      "title": "KnowledgeSearch",
      "type": "object"
    },
    "StoreIdentity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "owner": {
          "minimum": 0,
          "title": "Owner",
          "type": "integer"
        },
        "mode": {
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        }
      },
      "required": [
        "device",
        "inode",
        "owner",
        "mode"
      ],
      "title": "StoreIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "untrusted": {
      "const": true,
      "title": "Untrusted",
      "type": "boolean"
    },
    "execution_authorized": {
      "const": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "title": "Training Ready",
      "type": "boolean"
    },
    "gold": {
      "const": false,
      "title": "Gold",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "knowledge_answer_report",
      "title": "Kind",
      "type": "string"
    },
    "available": {
      "const": true,
      "title": "Available",
      "type": "boolean"
    },
    "answer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Answer Id"
    },
    "status": {
      "enum": [
        "idle",
        "pending",
        "ready",
        "needs_human",
        "cancelled",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "bundle_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Bundle Sha256"
    },
    "real_model": {
      "title": "Real Model",
      "type": "boolean"
    },
    "model_called": {
      "title": "Model Called",
      "type": "boolean"
    },
    "citation_binding_verified": {
      "title": "Citation Binding Verified",
      "type": "boolean"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeAnswerPreview"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_request": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Request"
    },
    "model_response": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Response"
    },
    "bundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeAnswerBundle"
        },
        {
          "type": "null"
        }
      ]
    },
    "historical_binding_verified": {
      "title": "Historical Binding Verified",
      "type": "boolean"
    },
    "current_source_valid": {
      "title": "Current Source Valid",
      "type": "boolean"
    },
    "current_authority_valid": {
      "title": "Current Authority Valid",
      "type": "boolean"
    },
    "semantic_relevance_verified": {
      "const": false,
      "title": "Semantic Relevance Verified",
      "type": "boolean"
    }
  },
  "required": [
    "untrusted",
    "execution_authorized",
    "training_ready",
    "gold",
    "schema_version",
    "kind",
    "available",
    "answer_id",
    "status",
    "bundle_sha256",
    "real_model",
    "model_called",
    "citation_binding_verified",
    "error_code",
    "preview",
    "model_request",
    "model_response",
    "bundle",
    "historical_binding_verified",
    "current_source_valid",
    "current_authority_valid",
    "semantic_relevance_verified"
  ],
  "title": "KnowledgeAnswerReport",
  "type": "object"
}
