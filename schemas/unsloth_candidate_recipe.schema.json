{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS isolated Unsloth candidate training design",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "candidate_id", "role", "status", "trainer", "methods", "base", "dataset", "compatibility", "adapter", "blocked_until", "promotion"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "recipe_id": {"type": "string", "pattern": "^unsloth-[a-z0-9_]+-v001$"},
    "candidate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$"},
    "role": {"enum": ["system1", "system2"]},
    "status": {"const": "design_recipe_not_executable"},
    "trainer": {"const": "unsloth"},
    "methods": {"const": ["lora", "qlora"]},
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "format", "artifact_manifest_sha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "format": {"const": "safetensors"},
        "artifact_manifest_sha256": {"type": "null"}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_schema", "manifest_sha256", "rights_review_required", "redaction_required", "group_split_required", "held_out_required", "hidden_reasoning_allowed"],
      "properties": {
        "canonical_schema": {"enum": ["schemas/system1_choice.schema.json", "schemas/system2_supervisor.schema.json"]},
        "manifest_sha256": {"type": "null"},
        "rights_review_required": {"const": true}, "redaction_required": {"const": true},
        "group_split_required": {"const": true}, "held_out_required": {"const": true},
        "hidden_reasoning_allowed": {"const": false}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["unsloth_revision", "dependency_lock_sha256", "converter_id", "aos_training_verified", "upstream_reference", "custom_joint_head_required"],
      "properties": {
        "unsloth_revision": {"type": "null"}, "dependency_lock_sha256": {"type": "null"},
        "converter_id": {"type": "null"}, "aos_training_verified": {"const": false},
        "upstream_reference": {"type": "string", "pattern": "^https://(?:unsloth[.]ai/docs/|huggingface[.]co/Cloudflare/clef)"},
        "custom_joint_head_required": {"type": "boolean"}
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["target_modules", "rank_proposal", "alpha_proposal", "stacking_allowed", "cross_base_reuse_allowed"],
      "properties": {
        "target_modules": {"type": "null"},
        "rank_proposal": {"const": 8}, "alpha_proposal": {"const": 16},
        "stacking_allowed": {"const": false}, "cross_base_reuse_allowed": {"const": false}
      }
    },
    "blocked_until": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
    "promotion": {"const": "explicit_after_held_out_evaluation_and_rollback_review"}
  }
}
