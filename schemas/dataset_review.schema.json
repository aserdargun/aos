{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS synthetic dataset review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_family": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "near_duplicate_cluster": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "review_status": {
            "enum": [
              "accepted",
              "pending",
              "rejected"
            ]
          }
        },
        "required": [
          "sample_id",
          "record_sha256",
          "task_family",
          "near_duplicate_cluster",
          "review_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "reviews"
  ],
  "additionalProperties": false
}
