{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CandidateExecutionAdmission": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "candidate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "source_group_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Group Sha256",
          "type": "string"
        },
        "source_run_ref": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Run Ref",
          "type": "string"
        },
        "source_parameter_variant_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Parameter Variant Sha256",
          "type": "string"
        },
        "parameter_variant_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parameter Variant Sha256",
          "type": "string"
        },
        "invocation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Invocation Sha256",
          "type": "string"
        },
        "recipe_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Recipe Sha256",
          "type": "string"
        },
        "skill_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Skill Sha256",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "purpose": {
          "const": "development_variation",
          "title": "Purpose",
          "type": "string"
        },
        "independent_held_out": {
          "const": false,
          "title": "Independent Held Out",
          "type": "boolean"
        },
        "dataset_ingestion_authorized": {
          "const": false,
          "title": "Dataset Ingestion Authorized",
          "type": "boolean"
        },
        "execution_authorized": {
          "const": false,
          "title": "Execution Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "candidate_sha256",
        "source_group_sha256",
        "source_run_ref",
        "source_parameter_variant_sha256",
        "parameter_variant_sha256",
        "invocation_sha256",
        "recipe_sha256",
        "skill_sha256",
        "profile_sha256",
        "purpose",
        "independent_held_out",
        "dataset_ingestion_authorized",
        "execution_authorized"
      ],
      "title": "CandidateExecutionAdmission",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "status": {
      "const": "source_bound_development_execution",
      "title": "Status",
      "type": "string"
    },
    "admission": {
      "$ref": "#/$defs/CandidateExecutionAdmission"
    },
    "admission_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Admission Sha256",
      "type": "string"
    },
    "source_group_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Group Sha256",
      "type": "string"
    },
    "source_run_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Run Ref",
      "type": "string"
    },
    "execution_run_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Execution Run Ref",
      "type": "string"
    },
    "source_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Snapshot Sha256",
      "type": "string"
    },
    "recipe_audit_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Recipe Audit Sha256",
      "type": "string"
    },
    "admission_observation_ref": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Admission Observation Ref",
      "type": "string"
    },
    "source_bound": {
      "const": true,
      "title": "Source Bound",
      "type": "boolean"
    },
    "executable_recipe_executed": {
      "const": true,
      "title": "Executable Recipe Executed",
      "type": "boolean"
    },
    "source_and_execution_events_disjoint": {
      "const": true,
      "title": "Source And Execution Events Disjoint",
      "type": "boolean"
    },
    "held_out_independence_verified": {
      "const": false,
      "title": "Held Out Independence Verified",
      "type": "boolean"
    },
    "site_outcome_verified": {
      "const": false,
      "title": "Site Outcome Verified",
      "type": "boolean"
    },
    "skill_validated": {
      "const": false,
      "title": "Skill Validated",
      "type": "boolean"
    },
    "dataset_ingestion_authorized": {
      "const": false,
      "title": "Dataset Ingestion Authorized",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "title": "Training Ready",
      "type": "boolean"
    },
    "activation_authorized": {
      "const": false,
      "title": "Activation Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "status",
    "admission",
    "admission_sha256",
    "source_group_sha256",
    "source_run_ref",
    "execution_run_ref",
    "source_snapshot_sha256",
    "recipe_audit_sha256",
    "admission_observation_ref",
    "source_bound",
    "executable_recipe_executed",
    "source_and_execution_events_disjoint",
    "held_out_independence_verified",
    "site_outcome_verified",
    "skill_validated",
    "dataset_ingestion_authorized",
    "training_ready",
    "activation_authorized"
  ],
  "title": "CandidateExecutionReport",
  "type": "object"
}
