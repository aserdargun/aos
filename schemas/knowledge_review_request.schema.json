{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "KnowledgeReviewPreview": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_review_preview",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/KnowledgeScope"
        },
        "document_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "revoke"
          ],
          "title": "Decision",
          "type": "string"
        },
        "previous_review_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Review Sha256"
        },
        "preview_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Preview Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scope",
        "document_sha256",
        "decision",
        "previous_review_sha256",
        "preview_sha256"
      ],
      "title": "KnowledgeReviewPreview",
      "type": "object"
    },
    "KnowledgeScope": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Application Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "account_role": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Account Role",
          "type": "string"
        }
      },
      "required": [
        "application_id",
        "tenant_id",
        "account_role"
      ],
      "title": "KnowledgeScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "preview": {
      "$ref": "#/$defs/KnowledgeReviewPreview"
    },
    "confirm_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Confirm Sha256",
      "type": "string"
    },
    "lease_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Lease Id",
      "type": "string"
    },
    "generation": {
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "preview",
    "confirm_sha256",
    "lease_id",
    "generation"
  ],
  "title": "ReviewRequest",
  "type": "object"
}
