{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned adapter per-call inference proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "call_id",
    "run_id",
    "step_id",
    "deployment_id",
    "binding_sha256",
    "artifact_sha256",
    "runtime_worker_sha256",
    "request_sha256",
    "response_sha256",
    "adapter_hook_calls",
    "adapter_loaded",
    "base_parameters_unchanged",
    "training_ready",
    "promotion_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "const": true
    },
    "call_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_worker_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter_hook_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "adapter_loaded": {
      "const": true
    },
    "base_parameters_unchanged": {
      "const": true
    },
    "training_ready": {
      "const": false
    },
    "promotion_authorized": {
      "const": false
    }
  }
}
