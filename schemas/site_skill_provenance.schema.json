{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS read-only manual skill source provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "skill_sha256", "profile_sha256", "model_role", "candidate_kind", "source_event_ids", "source_event_count", "source_request_sha256", "deployment_id", "deployment_sha256", "model_kind", "claimed_verification_ids", "direct_verification_status", "has_direct_verified_outcome", "has_downstream_verification", "run_ref", "snapshot_sha256", "status", "profile_bound", "reviewed", "execution_authorized", "collection_authorized", "activation_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_skill_source_inspection"},
    "skill_sha256": {"$ref": "#/$defs/hash"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "model_role": {"enum": ["system1", "system2"]},
    "candidate_kind": {"enum": ["finite_action_choice", "workflow_plan"]},
    "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^learning-[a-f0-9]{64}$"}},
    "source_event_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "source_request_sha256": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "deployment_id": {"$ref": "#/$defs/id"},
    "deployment_sha256": {"$ref": "#/$defs/hash"},
    "model_kind": {"enum": ["decider_native_worker", "laya_candidate", "bonsai_native_supervisor"]},
    "claimed_verification_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "direct_verification_status": {"enum": ["claimed_and_matched", "not_claimed", "absent_for_system2"]},
    "has_direct_verified_outcome": {"type": "boolean"},
    "has_downstream_verification": {"type": "boolean"},
    "run_ref": {"$ref": "#/$defs/hash"},
    "snapshot_sha256": {"$ref": "#/$defs/hash"},
    "status": {"const": "unreviewed_source_match"},
    "profile_bound": {"const": false},
    "reviewed": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"model_role": {"const": "system1"}}},
      "then": {"properties": {
        "candidate_kind": {"const": "finite_action_choice"},
        "model_kind": {"enum": ["decider_native_worker", "laya_candidate"]},
        "direct_verification_status": {"enum": ["claimed_and_matched", "not_claimed"]},
        "has_downstream_verification": {"const": false}
      }}
    },
    {
      "if": {"properties": {"model_role": {"const": "system2"}}},
      "then": {"properties": {
        "candidate_kind": {"const": "workflow_plan"},
        "model_kind": {"const": "bonsai_native_supervisor"},
        "claimed_verification_ids": {"maxItems": 0},
        "direct_verification_status": {"const": "absent_for_system2"},
        "has_direct_verified_outcome": {"const": false}
      }}
    }
  ]
}
