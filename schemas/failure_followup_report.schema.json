{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FollowupOutcome": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "verified",
            "not_verified",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification_count": {
          "maximum": 500,
          "minimum": 0,
          "title": "Verification Count",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "fixed_task_outcome",
            "transport_readback",
            "none"
          ],
          "title": "Scope",
          "type": "string"
        },
        "reason": {
          "enum": [
            "independent_evidence_verified",
            "run_not_settled_success",
            "evidence_missing_or_changed",
            "task_contract_unsupported"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "verification_count",
        "scope",
        "reason"
      ],
      "title": "FollowupOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manual_approval_required": {
      "const": true,
      "title": "Manual Approval Required",
      "type": "boolean"
    },
    "guidance_applied": {
      "const": false,
      "title": "Guidance Applied",
      "type": "boolean"
    },
    "causality_verified": {
      "const": false,
      "title": "Causality Verified",
      "type": "boolean"
    },
    "gold": {
      "const": false,
      "title": "Gold",
      "type": "boolean"
    },
    "training_ready": {
      "const": false,
      "title": "Training Ready",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Job Id",
      "type": "string"
    },
    "source_job_id": {
      "pattern": "^[A-Za-z0-9_-]{1,100}$",
      "title": "Source Job Id",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "historical_binding_verified": {
      "title": "Historical Binding Verified",
      "type": "boolean"
    },
    "current_source_valid": {
      "title": "Current Source Valid",
      "type": "boolean"
    },
    "current_review_valid": {
      "title": "Current Review Valid",
      "type": "boolean"
    },
    "outcome": {
      "$ref": "#/$defs/FollowupOutcome"
    }
  },
  "required": [
    "manual_approval_required",
    "guidance_applied",
    "causality_verified",
    "gold",
    "training_ready",
    "schema_version",
    "job_id",
    "source_job_id",
    "intent_sha256",
    "historical_binding_verified",
    "current_source_valid",
    "current_review_valid",
    "outcome"
  ],
  "title": "FailureFollowupReport",
  "type": "object"
}
