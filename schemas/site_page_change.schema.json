{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS unbound synthetic local-page change report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "status", "page_key", "fingerprint_version", "before", "after", "profile_bound", "reviewed", "execution_authorized", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "read_only_synthetic_page_change"},
    "status": {"enum": ["unchanged_unbound", "changed_unbound"]},
    "page_key": {"enum": ["start", "details"]},
    "fingerprint_version": {"const": "synthetic-local-page-v1"},
    "before": {"$ref": "#/$defs/source"},
    "after": {"$ref": "#/$defs/source"},
    "profile_bound": {"const": false},
    "reviewed": {"const": false},
    "execution_authorized": {"const": false},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_ref", "snapshot_sha256", "page_fingerprint_sha256"],
      "properties": {
        "run_ref": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
