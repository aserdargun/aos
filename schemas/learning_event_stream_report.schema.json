{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS opt-in synthetic incremental learning metadata report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "run_ref", "source_ref", "source_snapshot_sha256", "run_status", "roles", "new_entries", "total_entries", "entries_by_role", "synthetic", "metadata_only", "collection_authorized", "training_ready"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["opt_in_synthetic_metadata_poll", "opt_in_synthetic_metadata_watch"]},
    "run_ref": {"$ref": "#/$defs/hash"},
    "source_ref": {"$ref": "#/$defs/hash"},
    "source_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "run_status": {"enum": ["created", "running", "paused", "waiting_human", "succeeded", "failed", "cancelled"]},
    "roles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["system1", "system2"]}},
    "new_entries": {"type": "integer", "minimum": 0, "maximum": 2000},
    "total_entries": {"type": "integer", "minimum": 0, "maximum": 2000},
    "entries_by_role": {"type": "object", "additionalProperties": false,
                        "properties": {"system1": {"type": "integer", "minimum": 0, "maximum": 2000},
                                       "system2": {"type": "integer", "minimum": 0, "maximum": 2000}}},
    "polls": {"type": "integer", "minimum": 1, "maximum": 1200},
    "synthetic": {"const": true},
    "metadata_only": {"const": true},
    "collection_authorized": {"const": false},
    "training_ready": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "allOf": [
    {"if": {"properties": {"mode": {"const": "opt_in_synthetic_metadata_watch"}}}, "then": {"required": ["polls"]}},
    {"if": {"properties": {"mode": {"const": "opt_in_synthetic_metadata_poll"}}}, "then": {"not": {"required": ["polls"]}}}
  ]
}
