{
  "$defs": {
    "NativeInhibitFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "owner_uid": {
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "device",
        "inode",
        "owner_uid"
      ],
      "title": "NativeInhibitFileIdentity",
      "type": "object"
    },
    "NativeMaintenanceStore": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "#/$defs/NativeMaintenanceStoreRecord"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "record",
        "content_sha256"
      ],
      "title": "NativeMaintenanceStore",
      "type": "object"
    },
    "NativeMaintenanceStoreRecord": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "directory": {
          "title": "Directory",
          "type": "string"
        },
        "directory_identity": {
          "$ref": "#/$defs/WorkspaceIdentity"
        },
        "lock_identity": {
          "$ref": "#/$defs/NativeInhibitFileIdentity"
        },
        "metadata_identity": {
          "$ref": "#/$defs/NativeInhibitFileIdentity"
        }
      },
      "required": [
        "directory",
        "directory_identity",
        "lock_identity",
        "metadata_identity"
      ],
      "title": "NativeMaintenanceStoreRecord",
      "type": "object"
    },
    "WorkspaceIdentity": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "descriptor-workspace-v1",
          "default": "descriptor-workspace-v1",
          "title": "Version",
          "type": "string"
        },
        "path_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Path Sha256",
          "type": "string"
        },
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "minimum": 1,
          "title": "Inode",
          "type": "integer"
        },
        "owner_uid": {
          "minimum": 0,
          "title": "Owner Uid",
          "type": "integer"
        }
      },
      "required": [
        "path_sha256",
        "device",
        "inode",
        "owner_uid"
      ],
      "title": "WorkspaceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1",
      "default": "1",
      "title": "Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^native-maintenance-[a-f0-9]{32}$",
      "title": "Request Id",
      "type": "string"
    },
    "store": {
      "$ref": "#/$defs/NativeMaintenanceStore"
    },
    "principal": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Principal",
      "type": "string"
    },
    "owner_uid": {
      "minimum": 1,
      "title": "Owner Uid",
      "type": "integer"
    },
    "expected_session": {
      "pattern": "^app-[a-f0-9]{32}$",
      "title": "Expected Session",
      "type": "string"
    },
    "handover_path": {
      "title": "Handover Path",
      "type": "string"
    },
    "handover_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Handover Sha256",
      "type": "string"
    },
    "original_state_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Original State Sha256",
      "type": "string"
    },
    "shared_plan_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Shared Plan Sha256",
      "type": "string"
    },
    "candidate_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "candidate_patch_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Patch Sha256",
      "type": "string"
    },
    "source_files": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxProperties": 512,
      "minProperties": 1,
      "title": "Source Files",
      "type": "object"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "config_files": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxProperties": 512,
      "minProperties": 1,
      "title": "Config Files",
      "type": "object"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "native_python_real_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Native Python Real Paths",
      "type": "array"
    },
    "native_server_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Native Server Paths",
      "type": "array"
    },
    "gpu_uuid": {
      "pattern": "^GPU-[a-fA-F0-9]{8}(-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}$",
      "title": "Gpu Uuid",
      "type": "string"
    },
    "boot_id": {
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$",
      "title": "Boot Id",
      "type": "string"
    },
    "clock": {
      "const": "CLOCK_BOOTTIME",
      "default": "CLOCK_BOOTTIME",
      "title": "Clock",
      "type": "string"
    },
    "issued_boottime": {
      "minimum": 0,
      "title": "Issued Boottime",
      "type": "number"
    },
    "expires_boottime": {
      "minimum": 0,
      "title": "Expires Boottime",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "store",
    "principal",
    "owner_uid",
    "expected_session",
    "handover_path",
    "handover_sha256",
    "original_state_sha256",
    "shared_plan_sha256",
    "candidate_manifest_sha256",
    "candidate_patch_sha256",
    "source_files",
    "source_sha256",
    "config_files",
    "config_sha256",
    "native_python_real_paths",
    "native_server_paths",
    "gpu_uuid",
    "boot_id",
    "issued_boottime",
    "expires_boottime"
  ],
  "title": "NativeMaintenanceRequest",
  "type": "object"
}
