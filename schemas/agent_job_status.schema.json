{
  "$defs": {
    "AgentAuthority": {
      "additionalProperties": false,
      "properties": {
        "principal": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Principal",
          "type": "string"
        },
        "runtime_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Runtime Id",
          "type": "string"
        },
        "lease_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Lease Id",
          "type": "string"
        },
        "owner": {
          "enum": [
            "AGENT",
            "HUMAN"
          ],
          "title": "Owner",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        }
      },
      "required": [
        "principal",
        "runtime_id",
        "lease_id",
        "owner",
        "generation"
      ],
      "title": "AgentAuthority",
      "type": "object"
    },
    "AgentBudget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "description": "Reserved wall-clock seconds, not measured or billed usage",
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_tokens": {
          "description": "Reserved model tokens, not a runtime GPU grant",
          "maximum": 10000000,
          "minimum": 0,
          "title": "Model Tokens",
          "type": "integer"
        },
        "experiments": {
          "description": "Reserved experiment count; zero for non-experiment operations",
          "maximum": 10000,
          "minimum": 0,
          "title": "Experiments",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "model_tokens",
        "experiments"
      ],
      "title": "AgentBudget",
      "type": "object"
    },
    "AgentCleanupProof": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "$ref": "#/$defs/AgentHandle"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "local_process",
            "scientist_gpu"
          ],
          "title": "Scope",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        }
      },
      "required": [
        "handle",
        "verified",
        "scope"
      ],
      "title": "AgentCleanupProof",
      "type": "object"
    },
    "AgentHandle": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Job Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/AgentAuthority"
        },
        "handle_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Handle Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "request_sha256",
        "authority",
        "handle_id",
        "payload"
      ],
      "title": "AgentHandle",
      "type": "object"
    },
    "AgentJobRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Job Id",
          "type": "string"
        },
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Agent Version",
          "type": "string"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Operation",
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/AgentAuthority"
        },
        "budget": {
          "$ref": "#/$defs/AgentBudget"
        },
        "dependencies": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Dependencies",
          "type": "array"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "delegated_by": {
          "const": "supervisor",
          "default": "supervisor",
          "title": "Delegated By",
          "type": "string"
        },
        "executed_by": {
          "const": "operator",
          "default": "operator",
          "title": "Executed By",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "agent_id",
        "agent_version",
        "operation",
        "authority",
        "budget",
        "payload"
      ],
      "title": "AgentJobRequest",
      "type": "object"
    },
    "AgentObservation": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "$ref": "#/$defs/AgentHandle"
        },
        "state": {
          "enum": [
            "waiting_approval",
            "ready",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "uncertain"
          ],
          "title": "State",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 2048,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "handle",
        "state"
      ],
      "title": "AgentObservation",
      "type": "object"
    },
    "AgentPrepared": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "$ref": "#/$defs/AgentHandle"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        }
      },
      "required": [
        "handle",
        "ready"
      ],
      "title": "AgentPrepared",
      "type": "object"
    },
    "AgentResultProof": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "$ref": "#/$defs/AgentHandle"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        }
      },
      "required": [
        "handle",
        "verified",
        "outcome"
      ],
      "title": "AgentResultProof",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/AgentJobRequest"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "registration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Registration Sha256",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "prepare_intent",
        "waiting_approval",
        "prepared",
        "dispatch_intent",
        "running",
        "cancel_intent",
        "cancel_requested",
        "verifying",
        "uncertain",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "prepared": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentPrepared"
        },
        {
          "type": "null"
        }
      ]
    },
    "handle": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentHandle"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_proof": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentResultProof"
        },
        {
          "type": "null"
        }
      ]
    },
    "cleanup_proof": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentCleanupProof"
        },
        {
          "type": "null"
        }
      ]
    },
    "reservation_held": {
      "title": "Reservation Held",
      "type": "boolean"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Error"
    }
  },
  "required": [
    "request",
    "request_sha256",
    "registration_sha256",
    "state",
    "prepared",
    "handle",
    "observation",
    "result_proof",
    "cleanup_proof",
    "reservation_held",
    "revision",
    "last_error"
  ],
  "title": "AgentJobStatus",
  "type": "object"
}
